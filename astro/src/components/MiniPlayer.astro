---
// The footer as a "now playing" mini player. Same layout on every page;
// every control does something real. The bar shows album position (track N
// of M), not reading progress: the top piano-key bar already does that, and
// the footer only comes into view at the end of a page.
import { PALETTES } from '../lib/site';

export interface Track {
  title: string;
  sub: string;
  number: number;
  total: number;
  length?: string;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
  comments?: boolean;
}

interface Props {
  track: Track;
}
const { track } = Astro.props;
const pct = Math.round((track.number / Math.max(1, track.total)) * 100);
---
<section class="player" aria-label="Now playing">
  <div class="inner">
    <div class="now">
      <span class="cover mono" aria-hidden="true">01</span>
      <div class="meta">
        <p class="title">{track.title}</p>
        <p class="sub">{track.sub}</p>
      </div>
      <div class="side">
        {track.comments ? (
          <a class="ctl" href="#comments-title" aria-label="Comments">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" /></svg>
          </a>
        ) : (
          <span class="ctl off" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" /></svg>
          </span>
        )}
        <a class="ctl" href="/rss.xml" aria-label="Subscribe (RSS)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </a>
      </div>
    </div>

    <div class="bar mono">
      <span>0:39</span>
      <span
        class="track"
        role="img"
        aria-label={`Track ${track.number} of ${track.total}`}
        style={`--pct: ${pct}%`}
      ><span class="fill"></span><span class="knob"></span></span>
      <span>{track.length ?? `${track.number}/${track.total}`}</span>
    </div>

    <div class="controls">
      <a class="ctl" href="/currently/#listen" aria-label="On repeat playlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h11M4 12h11M4 17h6" /><path d="M18 17V8l3-1" /><circle cx="16.5" cy="17" r="1.8" /></svg>
      </a>
      {track.prev ? (
        <a class="ctl" href={track.prev.href} aria-label={`Previous: ${track.prev.title}`} title={track.prev.title}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 6v12M18 6l-8 6 8 6Z" /></svg>
        </a>
      ) : (
        <span class="ctl off" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 6v12M18 6l-8 6 8 6Z" /></svg></span>
      )}
      <a class="ctl play" href="#top" aria-label="Back to top">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5Z" /></svg>
      </a>
      {track.next ? (
        <a class="ctl" href={track.next.href} aria-label={`Next: ${track.next.title}`} title={track.next.title}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 6v12M6 6l8 6-8 6Z" /></svg>
        </a>
      ) : (
        <span class="ctl off" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M17 6v12M6 6l8 6-8 6Z" /></svg></span>
      )}
      <button class="ctl" type="button" data-shuffle aria-label="Shuffle palette">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h3.5c4 0 6 10 10 10H21M3 17h3.5c1.6 0 2.8-1.6 3.9-3.6M13.6 9.6C14.7 8 15.6 7 17 7h4M18 4l3 3-3 3M18 14l3 3-3 3" /></svg>
      </button>
    </div>
    <p class="palette mono" aria-live="polite"><span data-palette-name>{PALETTES[0].name}</span></p>
  </div>
</section>

<script is:inline define:vars={{ palettes: PALETTES }}>
  (() => {
    const button = document.querySelector('[data-shuffle]');
    const label = document.querySelector('[data-palette-name]');
    const show = () => {
      const id = document.documentElement.dataset.palette ?? 'teal';
      label.textContent = (palettes.find((p) => p.id === id) ?? palettes[0]).name;
    };
    show();
    button?.addEventListener('click', () => {
      const id = document.documentElement.dataset.palette ?? 'teal';
      const next = palettes[(palettes.findIndex((p) => p.id === id) + 1) % palettes.length];
      if (next.id === 'teal') delete document.documentElement.dataset.palette;
      else document.documentElement.dataset.palette = next.id;
      localStorage.setItem('palette', next.id);
      show();
    });
  })();
</script>

<style>
  .player {
    background: var(--glow);
    color: #2b2f32;
    padding: 1.4rem 0 1.2rem;
  }

  :global(:root[data-theme='dark']) .player {
    background: var(--surface);
    color: var(--ink);
    border-top: 2px solid var(--glow);
  }

  .inner {
    width: min(100% - 2.5rem, 40rem);
    margin: 0 auto;
  }

  .now {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
  }

  .cover {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 10px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    box-shadow: 0 4px 0 rgb(0 0 0 / 0.18);
  }

  .meta p {
    margin: 0;
    line-height: 1.4;
  }

  .title {
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sub {
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The site focus ring is --glow, which is this band's own color in light
     mode; use ink there so keyboard focus stays visible. */
  .player :focus-visible {
    outline-color: #2b2f32;
  }

  :global(:root[data-theme='dark']) .player :focus-visible {
    outline-color: var(--glow);
  }

  .side {
    display: flex;
    gap: 0.2rem;
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.75rem;
    margin: 1.1rem 0 0.6rem;
  }

  .track {
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: rgb(43 47 50 / 0.25);
  }

  :global(:root[data-theme='dark']) .track {
    background: var(--line);
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pct);
    border-radius: inherit;
    background: currentColor;
  }

  :global(:root[data-theme='dark']) .fill,
  :global(:root[data-theme='dark']) .knob {
    background: var(--glow);
  }

  .knob {
    position: absolute;
    top: 50%;
    left: var(--pct);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.1rem;
  }

  .ctl {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  :global(:root[data-theme='dark']) .ctl {
    color: var(--glow);
  }

  .ctl:hover {
    transform: scale(1.12);
  }

  .ctl svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ctl.off {
    opacity: 0.35;
    cursor: default;
  }

  .ctl.off:hover {
    transform: none;
  }

  .play {
    width: 3.4rem;
    height: 3.4rem;
    background: #2b2f32;
    color: var(--glow);
  }

  :global(:root[data-theme='dark']) .play {
    background: var(--glow);
    color: var(--surface);
  }

  .play svg {
    fill: currentColor;
    stroke: none;
  }

  .palette {
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0.5rem 0 0;
  }
</style>
