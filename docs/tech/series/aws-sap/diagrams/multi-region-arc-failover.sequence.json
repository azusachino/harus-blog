    },
    {
      "id": "m2",
      "from": "primary_region",
      "to": "arc_control",
      "y": 220,
      "label": "2. Regional impairment triggers ARC Readiness Check failure alarm"
    },
    {
      "id": "m3",
      "from": "arc_control",
      "to": "r53_dns",
      "y": 300,
      "label": "3. Automated safety rule disengages us-east-1 routing control",
