      "label": "Route 53 DNS Data Plane",
      "sublabel": "5 redundant regional cells"
    },
    {
      "id": "primary_region",
      "type": "database",
      "label": "Primary Region (us-east-1)",
      "sublabel": "Impaired active stack"
    },
    {
      "id": "secondary_region",
      "type": "database",
      "label": "Secondary Region (us-west-2)",
      "sublabel": "Standby warm capacity"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 250,
      "label": "Phase 1: Impairment Detection & Readiness Assessment"
    },
    {
      "from": 280,
      "to": 370,
      "label": "Phase 2: ARC Routing Control State Flip & Cell Redirection"
    },
    {
      "from": 400,
      "to": 490,
      "label": "Phase 3: Global DNS Steering & Traffic Evacuation"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "client_traffic",
      "to": "primary_region",
      "y": 180,
      "label": "1. Normal live traffic routed to active us-east-1 endpoint",
