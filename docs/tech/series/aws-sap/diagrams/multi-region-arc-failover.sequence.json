    },
    {
      "id": "m4",
      "from": "arc_control",
      "to": "r53_dns",
      "y": 345,
      "label": "4. Regional routing control engages us-west-2 secondary cell"
    },
    {
      "id": "m5",
      "from": "r53_dns",
      "to": "secondary_region",
      "y": 415,
      "label": "5. DNS records updated across global edge locations with 0s TTL"
    },
    {
      "id": "m6",
      "from": "client_traffic",
      "to": "secondary_region",
      "y": 455,
      "label": "6. Client requests re-routed to healthy us-west-2 stack (RTO < 60s)",
      "variant": "emphasis"
    }
  ]
