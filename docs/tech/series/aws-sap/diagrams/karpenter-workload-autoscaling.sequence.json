    },
    {
      "id": "m5",
      "from": "eks_node",
      "to": "kube_sched",
      "y": 415,
      "label": "5. NodeReady event & kubelet registers to API server"
    },
    {
      "id": "m6",
      "from": "kube_sched",
      "to": "app_pod",
      "y": 455,
      "label": "6. Pod successfully bound and transitioned to Running state",
