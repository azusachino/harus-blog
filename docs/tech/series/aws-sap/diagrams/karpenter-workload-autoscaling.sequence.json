  ],
  "segments": [
    {
      "from": 160,
      "to": 250,
      "label": "Phase 1: Pod Scheduling Failure & Unschedulable Event"
    },
    {
      "from": 280,
      "to": 370,
      "label": "Phase 2: JIT Bin-Packing & Direct EC2 Fleet Provisioning"
    },
    {
      "from": 400,
      "to": 490,
      "label": "Phase 3: Rapid Node Registration & Workload Execution"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "app_pod",
      "to": "kube_sched",
      "y": 180,
