      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "kube_sched",
      "to": "karpenter",
      "y": 220,
      "label": "2. Emits PodScheduled=False (Unschedulable event detected)"
    },
    {
      "id": "m3",
      "from": "karpenter",
      "to": "ec2_fleet",
      "y": 300,
