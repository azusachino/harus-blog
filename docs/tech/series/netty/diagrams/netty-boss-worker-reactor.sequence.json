    },
    {
      "id": "m5",
      "from": "outbound_buf",
      "to": "pipeline",
      "y": 415,
      "label": "5. If totalPendingWriteBytes > 64 KB -> flip isWritable()=false & fireChannelWritabilityChanged()",
