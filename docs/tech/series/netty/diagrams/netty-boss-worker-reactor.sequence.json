  "segments": [
    {
      "from": 160,
      "to": 255,
      "label": "1. Connection Acceptance & Pinning to a Single Worker EventLoop"
    },
    {
      "from": 285,
      "to": 455,
      "label": "2. Lock-Free Pipeline Execution & Write Watermark Backpressure"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "boss",
      "to": "worker",
      "y": 175,
      "label": "1. Accept NioSocketChannel & next().register(channel) via MPSC taskQueue",
