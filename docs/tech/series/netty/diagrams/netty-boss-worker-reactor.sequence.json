    },
    {
      "id": "m3",
      "from": "worker",
      "to": "pipeline",
      "y": 300,
      "label": "3. OP_READ ready -> read DirectByteBuf -> fireChannelRead() through InboundHandlers",
      "variant": "emphasis"
    },
    {
      "id": "m4",
      "from": "pipeline",
      "to": "outbound_buf",
      "y": 350,
      "label": "4. ctx.writeAndFlush(msg) -> OutboundHandlers -> stage in ChannelOutboundBuffer",
