{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "SOPS-nix Runtime Secret Decryption into RAM-backed Storage",
    "quality_profile": "standard",
    "output": "sops-nix-secret-lifecycle.workflow.html"
  },
  "lanes": [
    {
      "id": "git_lane",
      "label": "Version Control & SOPS Envelope (Committed Repository)"
    },
    {
      "id": "crypto_lane",
      "label": "Age Key Decryption Engine (Host Private Key in /etc/ssh)"
    },
    {
      "id": "ram_lane",
      "label": "Runtime Volatile Storage (/run/secrets/ on tmpfs / ramfs)"
    }
  ],
  "mainPath": [
    "sops_yaml",
    "host_age_key",
    "sops_nix_daemon",
    "tmpfs_mount",
    "target_service"
  ],
  "nodes": [
    {
      "id": "sops_yaml",
      "lane": "git_lane",
      "col": 0,
      "label": "Encrypted secrets.yaml",
      "sublabel": "AES-256 session key in git",
      "type": "database"
    },
    {
      "id": "host_age_key",
      "lane": "crypto_lane",
      "col": 1,
      "label": "Host Age Key Pair",
      "sublabel": "Derived from /etc/ssh host key",
      "type": "security"
    },
    {
      "id": "sops_nix_daemon",
      "lane": "crypto_lane",
      "col": 2,
      "label": "sops-nix Activation Hook",
      "sublabel": "Decrypts session key in memory",
      "type": "backend"
    },
    {
      "id": "tmpfs_mount",
      "lane": "ram_lane",
      "col": 3,
      "label": "/run/secrets/ Mount",
      "sublabel": "RAM-only filesystem (0400)",
      "type": "database"
    },
    {
      "id": "target_service",
      "lane": "ram_lane",
      "col": 4,
      "label": "Service File Descriptor",
      "sublabel": "Reads plaintext from RAM fd",
      "type": "frontend"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "sops_yaml",
      "to": "host_age_key",
      "label": "1. Provide envelope"
    },
    {
      "id": "e2",
      "from": "host_age_key",
      "to": "sops_nix_daemon",
      "label": "2. Decrypt session key"
    },
    {
      "id": "e3",
      "from": "sops_nix_daemon",
      "to": "tmpfs_mount",
      "label": "3. Materialize to tmpfs"
    },
    {
      "id": "e4",
      "from": "tmpfs_mount",
      "to": "target_service",
      "label": "4. Secure service read"
    }
  ]
}
