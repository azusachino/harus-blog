{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Aeron Three-Term Log Buffer Publication, Receiver Window & NAK Recovery",
    "quality_profile": "standard",
    "output": "aeron-logbuffer-transport.sequence.html"
  },
  "participants": [
    {
      "id": "pub",
      "type": "frontend",
      "label": "Aeron Publication",
      "sublabel": "Client Process (mmap Term)"
    },
    {
      "id": "sender",
      "type": "backend",
      "label": "MediaDriver Sender",
      "sublabel": "SendChannelEndpoint Duty Cycle"
    },
    {
      "id": "receiver",
      "type": "backend",
      "label": "MediaDriver Receiver",
      "sublabel": "TermRebuilder & GapScanner"
    },
    {
      "id": "sub",
      "type": "database",
      "label": "Aeron Subscription",
      "sublabel": "TermReader (Image Poll)"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 260,
      "label": "1. Lock-Free 64-Bit Atomic Tail Reservation & Zero-Copy Term Write"
    },
    {
      "from": 290,
      "to": 465,
      "label": "2. UDP Datagram Dispatch, Out-of-Order Rebuild, NAK & Status Message Window"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "pub",
      "to": "sender",
      "y": 175,
      "label": "1. get_and_add_raw_tail() reserves (term_id<<32 | offset) in Active Term",
      "variant": "emphasis"
    },
    {
      "id": "m2",
      "from": "pub",
      "to": "sender",
      "y": 225,
      "label": "2. Write 32B DataHeaderFlyweight + payload; release positive frame_length",
      "variant": "default"
    },
    {
      "id": "m3",
      "from": "sender",
      "to": "receiver",
      "y": 305,
      "label": "3. Transmit UDP DATA frame within subscriber receiverWindowLength",
      "variant": "emphasis"
    },
    {
      "id": "m4",
      "from": "receiver",
      "to": "sub",
      "y": 350,
      "label": "4. TermRebuilder inserts frame at term_offset; TermReader polls contiguous span",
      "variant": "default"
    },
    {
      "id": "m5",
      "from": "receiver",
      "to": "sender",
      "y": 395,
      "label": "5. TermGapScanner detects missing offset -> send unicast/multicast NAK",
      "variant": "return"
    },
    {
      "id": "m6",
      "from": "receiver",
      "to": "sender",
      "y": 440,
      "label": "6. Periodic Status Message (SM) advances publisherLimit counter",
      "variant": "return"
    }
  ]
}
