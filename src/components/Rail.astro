---
// Left rail for wide screens (see Base.astro): the Magical Mirai theme songs,
// from the magicalMirai collection (src/data/magical-mirai.yaml).
import { getCollection } from 'astro:content';

const themes = (await getCollection('magicalMirai')).sort((a, b) => b.id.localeCompare(a.id));
---
<aside class="rail" aria-label="Magical Mirai" transition:persist>
  <h2>Magical Mirai</h2>
  <ol class="themes">
    {themes.map(({ id, data }) => (
      <li>
        {data.youtube && (
          <a class="thumb" href={`https://www.youtube.com/watch?v=${data.youtube}`} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <img src={`/assets/magical-mirai/${data.youtube}.jpg`} alt="" width="480" height="360" loading="lazy" />
          </a>
        )}
        <span class="mono">{id}</span>
        {data.youtube ? (
          <a class="title" href={`https://www.youtube.com/watch?v=${data.youtube}`} target="_blank" rel="noopener noreferrer">{data.title}</a>
        ) : (
          <span class="title">{data.title}</span>
        )}
        <span class="muted">{data.producer}</span>
      </li>
    ))}
  </ol>
</aside>

<style>
  /* Shown and hidden by the breakpoint in Base.astro. Floats in the right gutter as plain text, no box. */
  .rail {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    /* Taller than a laptop screen: the rail scrolls inside itself, not with the page. */
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    width: 13rem;
    margin: 0 1rem 0 0.75rem;
    font-size: 0.85rem;
  }

  .rail h2 {
    font-size: 0.9rem;
    margin: 0 0 0.6rem;
  }

  .themes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .themes li {
    display: grid;
    gap: 0.1rem;
  }

  .themes .title {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .themes a.title:hover {
    color: var(--primary);
  }

  .thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    background: var(--line);
  }

  .themes .mono {
    color: var(--accent);
    font-size: 0.75rem;
  }

  .themes .muted {
    font-size: 0.75rem;
  }
</style>
