---
// Zero-dependency client search modal powered by Pagefind at build time.
---
<dialog id="search-modal" class="search-modal" aria-label="Search posts">
  <div class="search-container">
    <div class="search-input-wrap">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="Search articles, notes, series... (⌘K or /)"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="search-close mono" id="search-close-btn" aria-label="Close search">
        <kbd>Esc</kbd>
      </button>
    </div>

    <div class="search-status mono muted" id="search-status" aria-live="polite">
      Type to start searching...
    </div>

    <ul class="search-results" id="search-results" role="listbox" aria-label="Search results"></ul>
  </div>
</dialog>

<script>
  (() => {
    const dialog = document.getElementById('search-modal') as HTMLDialogElement | null;
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const resultsList = document.getElementById('search-results');
    const closeBtn = document.getElementById('search-close-btn');

    if (!dialog || !input || !status || !resultsList) return;

    let pagefind: any = null;
    let selectedIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout> | undefined;

    // Helper to format clean blog routes
    function cleanUrl(url: string): string {
      const cleaned = url.replace(/\.html$/, '').replace(/\/index$/, '');
      return cleaned.endsWith('/') ? cleaned : `${cleaned}/`;
    }

    const dynamicImport = new Function('specifier', 'return import(specifier)') as (specifier: string) => Promise<any>;

    async function ensurePagefind() {
      if (pagefind) return pagefind;
      try {
        // Native dynamic import via function constructor avoids Vite bundle/public-folder inspection
        pagefind = await dynamicImport('/pagefind/pagefind.js');
        if (pagefind.init) await pagefind.init();
        return pagefind;
      } catch (err) {
        console.warn('Pagefind index not found (available in production build or after pagefind runs):', err);
        return null;
      }
    }

    function openModal() {
      if (dialog && !dialog.open) {
        dialog.showModal();
        input?.focus();
        ensurePagefind();
      }
    }

    function closeModal() {
      if (dialog && dialog.open) {
        dialog.close();
        if (input) input.value = '';
        renderResults([], '');
        status!.textContent = 'Type to start searching...';
      }
    }

    // Attach global keyboard shortcuts: Cmd+K / Ctrl+K / '/'
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) closeModal();
        else openModal();
        return;
      }

      if (e.key === '/' && !dialog.open) {
        const target = e.target as HTMLElement | null;
        const tag = target?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA' && !target?.isContentEditable) {
          e.preventDefault();
          openModal();
          return;
        }
      }

      if (dialog.open) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
          return;
        }

        const items = resultsList.querySelectorAll<HTMLAnchorElement>('.search-item a');
        if (items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = (selectedIndex + 1) % items.length;
          updateSelected(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = (selectedIndex - 1 + items.length) % items.length;
          updateSelected(items);
        } else if (e.key === 'Enter' && selectedIndex >= 0 && selectedIndex < items.length) {
          e.preventDefault();
          items[selectedIndex].click();
        }
      }
    });

    function updateSelected(items: NodeListOf<HTMLAnchorElement>) {
      items.forEach((item, idx) => {
        const parent = item.parentElement;
        if (idx === selectedIndex) {
          parent?.classList.add('selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          parent?.classList.remove('selected');
        }
      });
    }

    // Backdrop click dismiss
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!inDialog) closeModal();
    });

    closeBtn?.addEventListener('click', closeModal);

    // Global trigger buttons (e.g. from Header)
    document.querySelectorAll('[data-search-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => openModal());
    });

    // Handle typing in search input
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = input.value.trim();
      if (!query) {
        status.textContent = 'Type to start searching...';
        renderResults([], '');
        return;
      }

      status.textContent = 'Searching...';
      debounceTimer = setTimeout(() => executeSearch(query), 120);
    });

    async function executeSearch(query: string) {
      const pf = await ensurePagefind();
      if (!pf) {
        status!.textContent = 'Search index ready after static build (run `bun run build`).';
        renderResults([], query);
        return;
      }

      try {
        const search = await pf.search(query);
        const count = search.results.length;
        if (count === 0) {
          status!.textContent = `No results found for "${query}"`;
          renderResults([], query);
          return;
        }

        status!.textContent = `Found ${count} result${count > 1 ? 's' : ''}`;
        const topResults = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
        renderResults(topResults, query);
      } catch (err) {
        console.error('Search error:', err);
        status!.textContent = 'Search encountered an error.';
      }
    }

    function renderResults(results: any[], query: string) {
      resultsList!.innerHTML = '';
      selectedIndex = -1;

      if (results.length === 0) return;

      results.forEach((item, index) => {
        const li = document.createElement('li');
        li.className = 'search-item';
        li.setAttribute('role', 'option');

        const a = document.createElement('a');
        a.href = cleanUrl(item.url);
        a.className = 'search-link';

        const titleSpan = document.createElement('span');
        titleSpan.className = 'search-title';
        titleSpan.textContent = item.meta?.title || item.url;

        const excerptP = document.createElement('p');
        excerptP.className = 'search-excerpt';
        // Pagefind returns safe sanitized HTML excerpts with <mark> tags
        excerptP.innerHTML = item.excerpt;

        a.appendChild(titleSpan);
        a.appendChild(excerptP);
        li.appendChild(a);

        // Hover selects
        li.addEventListener('mouseenter', () => {
          selectedIndex = index;
          const items = resultsList!.querySelectorAll<HTMLAnchorElement>('.search-item a');
          updateSelected(items);
        });

        resultsList!.appendChild(li);
      });
    }
  })();
</script>

<style>
  .search-modal {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    padding: 0;
    max-width: 42rem;
    width: min(92vw, 42rem);
    margin: 10vh auto auto auto;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }

  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
  }

  .search-container {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .search-icon {
    color: var(--muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--ink);
    background: none;
    border: none;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .search-close {
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    cursor: pointer;
  }

  .search-close:hover {
    color: var(--ink);
    border-color: var(--glow);
  }

  .search-status {
    padding: 0.5rem 1.15rem;
    font-size: 0.75rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    overflow-y: auto;
    max-height: 55vh;
  }

  .search-item {
    border-left: 3px solid transparent;
    transition: background 0.1s ease, border-color 0.1s ease;
  }

  .search-item.selected {
    background: var(--bg);
    border-left-color: var(--glow);
  }

  .search-link {
    display: block;
    padding: 0.65rem 1.15rem;
    text-decoration: none;
    color: inherit;
  }

  .search-title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .search-item.selected .search-title {
    color: var(--primary);
  }

  .search-excerpt {
    margin: 0;
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.45;
  }

  :global(.search-excerpt mark) {
    background: var(--soft);
    color: var(--ink);
    border-radius: 2px;
    padding: 0.05em 0.2em;
    font-weight: 600;
  }
</style>
