---
// Quick switcher & full-text search modal powered by Pagefind and local document index,
// designed to match Apricot (vendor/apricot/site/src/components/HeaderControls.tsx).
---

<dialog id="search-modal" class="quick-switcher" aria-label="Quick switcher">
  <div class="switcher-wrapper">
    <div class="switcher-input-wrapper">
      <svg
        class="search-icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="search-input"
        class="switcher-input"
        type="text"
        aria-label="Find a document by title, tag or full text"
        placeholder="Search titles, tags and full text…"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="switcher-esc mono" id="search-close-btn" aria-label="Close search">
        <kbd>esc</kbd>
      </button>
    </div>

    <div id="search-list" class="switcher-list" role="listbox" aria-label="Search results">
      <div id="search-status" class="switcher-status" style="display: none;"></div>
      <div id="search-results-content"></div>
    </div>

    <div class="switcher-footer mono">
      <div class="switcher-footer-shortcuts">
        <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> open</span>
        <span><kbd>esc</kbd> close</span>
      </div>
      <div class="switcher-footer-brand">
        <span>Pagefind</span>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { setupSearchController } from '../lib/search';

  const dialog = document.getElementById('search-modal') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const listContainer = document.getElementById('search-list');
  const statusElement = document.getElementById('search-status');
  const resultsContent = document.getElementById('search-results-content');
  const closeBtn = document.getElementById('search-close-btn');

  if (dialog && input && listContainer && statusElement && resultsContent) {
    setupSearchController({
      dialog,
      input,
      listContainer,
      statusElement,
      resultsContent,
      closeBtn,
    });
  }
</script>

<style is:global>
  .quick-switcher {
    position: fixed;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    width: min(36rem, calc(100vw - 2rem));
    max-height: min(72vh, 580px);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    padding: 0;
    box-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.32), 0 0 0 1px var(--line);
    overflow: hidden;
    animation: switcher-in 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .quick-switcher::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    animation: switcher-backdrop-in 0.15s ease-out;
  }

  @keyframes switcher-in {
    from {
      opacity: 0;
      transform: translate(-50%, -8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }

  @keyframes switcher-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .quick-switcher .switcher-wrapper {
    display: flex;
    flex-direction: column;
    max-height: min(72vh, 580px);
  }

  .quick-switcher .switcher-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    min-height: 54px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    flex-shrink: 0;
  }

  .quick-switcher .search-icon {
    color: var(--muted);
    opacity: 0.6;
    flex-shrink: 0;
  }

  .quick-switcher .switcher-input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--ink);
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
  }

  .quick-switcher .switcher-input::placeholder {
    color: var(--muted);
    opacity: 0.75;
  }

  .quick-switcher .switcher-esc {
    font-size: 11px;
    color: var(--muted);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 1;
  }

  .quick-switcher .switcher-esc kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    color: var(--muted);
  }

  .quick-switcher .switcher-list {
    overflow-y: auto;
    max-height: min(55dvh, 420px);
    padding: 0.35rem 0.25rem;
    scroll-padding: 0.5rem;
  }

  .quick-switcher ul,
  .quick-switcher ol {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .quick-switcher a {
    text-decoration: none !important;
    color: inherit !important;
  }

  .quick-switcher .switcher-group {
    margin-bottom: 0.25rem;
  }

  .quick-switcher .switcher-group-heading {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    padding: 0.5rem 0.75rem 0.25rem;
  }

  .quick-switcher .switcher-group-list {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .quick-switcher .switcher-item {
    list-style: none !important;
    margin: 0.125rem 0.25rem !important;
    padding: 0 !important;
    border-radius: 8px;
    transition: background 0.1s ease;
  }

  .quick-switcher .switcher-link {
    cursor: pointer;
    padding: 0.65rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none !important;
    color: inherit !important;
    border-radius: 8px;
  }

  .quick-switcher .switcher-item.selected {
    background: color-mix(in srgb, var(--glow) 15%, var(--surface));
  }

  .quick-switcher .item-icon {
    color: var(--muted);
    flex-shrink: 0;
  }

  .quick-switcher .switcher-document {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex: 1;
  }

  .quick-switcher .switcher-title {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow-wrap: anywhere;
  }

  .quick-switcher .switcher-item.selected .switcher-title {
    color: var(--primary);
  }

  .quick-switcher .switcher-path {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
    font-size: 11px;
    font-family: var(--font-mono);
  }

  .quick-switcher .switcher-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .quick-switcher .switcher-excerpt mark {
    background: color-mix(in srgb, var(--glow) 35%, transparent);
    color: var(--ink);
    border-radius: 3px;
    padding: 0 0.1em;
    font-weight: 600;
  }

  .quick-switcher .item-arrow {
    margin-left: auto;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.1s ease;
    flex-shrink: 0;
  }

  .quick-switcher .switcher-item.selected .item-arrow {
    opacity: 1;
    color: var(--primary);
  }

  .quick-switcher .switcher-status {
    padding: 1.5rem 1rem;
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }

  .quick-switcher .switcher-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1.25rem;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }

  .quick-switcher .switcher-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
    background: var(--bg);
    flex-shrink: 0;
  }

  .quick-switcher .switcher-footer-shortcuts {
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }

  .quick-switcher .switcher-footer kbd {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 11px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
    margin-right: 0.2rem;
  }

  .quick-switcher .switcher-footer-brand {
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.75;
  }
</style>
