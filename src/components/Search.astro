---
// Zero-dependency client search modal powered by Pagefind at build time.
---
<dialog id="search-modal" class="search-modal" aria-label="Search posts">
  <div class="search-container">
    <div class="search-input-wrap">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="Search articles, notes, series... (⌘K or /)"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="search-close mono" id="search-close-btn" aria-label="Close search">
        <kbd>Esc</kbd>
      </button>
    </div>

    <div class="search-status mono muted" id="search-status" aria-live="polite">
      Type to start searching...
    </div>

    <ul class="search-results" id="search-results" role="listbox" aria-label="Search results"></ul>
  </div>
</dialog>

<script>
  import { setupSearchController } from '../lib/search';

  const dialog = document.getElementById('search-modal') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const status = document.getElementById('search-status');
  const resultsList = document.getElementById('search-results');
  const closeBtn = document.getElementById('search-close-btn');

  if (dialog && input && status && resultsList) {
    setupSearchController({ dialog, input, status, resultsList, closeBtn });
  }
</script>

<style>
  .search-modal {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    padding: 0;
    max-width: 42rem;
    width: min(92vw, 42rem);
    margin: 10vh auto auto auto;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.22);
    overflow: hidden;
  }

  .search-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
  }

  .search-container {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .search-icon {
    color: var(--muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--ink);
    background: none;
    border: none;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .search-close {
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    cursor: pointer;
  }

  .search-close:hover {
    color: var(--ink);
    border-color: var(--glow);
  }

  .search-status {
    padding: 0.5rem 1.15rem;
    font-size: 0.75rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    overflow-y: auto;
    max-height: 55vh;
  }

  .search-item {
    border-left: 3px solid transparent;
    transition: background 0.1s ease, border-color 0.1s ease;
  }

  .search-item.selected {
    background: var(--bg);
    border-left-color: var(--glow);
  }

  .search-link {
    display: block;
    padding: 0.65rem 1.15rem;
    text-decoration: none;
    color: inherit;
  }

  .search-title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .search-item.selected .search-title {
    color: var(--primary);
  }

  .search-excerpt {
    margin: 0;
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.45;
  }

  :global(.search-excerpt mark) {
    background: var(--soft);
    color: var(--ink);
    border-radius: 2px;
    padding: 0.05em 0.2em;
    font-weight: 600;
  }
</style>
