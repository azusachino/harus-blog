---
// Shared article layout for posts and series chapters: header with track
// badge, meta and waveform; body with a table of contents; previous/next.
import Comments from './Comments.astro';
import Mermaid from './Mermaid.astro';
// KaTeX output (build-time math, src/lib/math.ts); fonts load only where used.
import 'katex/dist/katex.min.css';
import Waveform from './Waveform.astro';

interface Link {
  href: string;
  title: string;
}
interface Props {
  lang: string;
  back: { href: string; label: string };
  badge?: string;
  title: string;
  date?: string;
  length: string;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
  prev?: Link;
  next?: Link;
  comments?: boolean;
  cover?: { src: string; alt?: string };
}
const { lang, back, badge, title, date, length, tags = [], headings, prev, next, comments = false, cover } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<article class="post" lang={lang}>
  <header>
    <p class="eyebrow">
      <a href={back.href}>{back.label}</a>
      {badge && <span class="badge">{badge}</span>}
    </p>
    <h1>{title}</h1>
    <p class="meta mono muted">
      {date && <time datetime={date}>{date}</time>}
      <span>♪ {length}</span>
      {tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
    </p>
    <Waveform seed={title} />
  </header>

  <div class="layout">
    <div class="prose">
      {cover && <img class="post-cover" src={encodeURI(cover.src)} alt={cover.alt ?? ''} />}
      <slot />
    </div>
    {toc.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ul>
          {toc.map((h) => (
            <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <nav class="prevnext" aria-label="More">
    {prev ? (
      <a href={prev.href}><span class="eyebrow">← previous track</span>{prev.title}</a>
    ) : <span />}
    {next && (
      <a class="next" href={next.href}><span class="eyebrow">next track →</span>{next.title}</a>
    )}
  </nav>

  {comments && <Comments />}
</article>
<Mermaid />

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.82rem;
    margin: 0.6rem 0 0;
  }

  .meta .tag {
    color: var(--muted);
    text-decoration: none;
  }

  .meta .tag:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  header .eyebrow {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    margin: 0 0 0.4rem;
  }

  .post {
    /* Center body + TOC as one block; otherwise wide screens leave the
       spare width all on the right. */
    max-width: calc(var(--measure) + 18rem);
    margin-inline: auto;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 15rem;
    gap: 3rem;
    margin-top: 1.5rem;
  }

  .toc {
    position: sticky;
    top: 1.5rem;
    align-self: start;
    font-size: 0.85rem;
    border-left: 2px solid var(--line);
    padding-left: 1rem;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc li {
    margin: 0.35rem 0;
    line-height: 1.5;
  }

  .toc .d3 {
    padding-left: 0.9rem;
  }

  .toc a {
    color: var(--muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--primary);
  }

  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    max-width: var(--measure);
  }

  .prevnext a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .prevnext a:hover {
    border-color: var(--glow);
  }

  .prevnext .next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }
</style>
