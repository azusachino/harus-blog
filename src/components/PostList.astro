---
import { day, href, trackLength, type Post, type Section } from '../lib/posts';

interface Props {
  section: Section;
  posts: Post[];
  total?: number;
}
const { section, posts, total = posts.length } = Astro.props;
---
<ol class="tracks">
  {posts.map((post, i) => (
    <li>
      <span class="badge">#{String(total - i).padStart(3, '0')}</span>
      <a href={href(section, post)}>{post.data.title}</a>
      <span class="meta mono muted">
        <time datetime={day(post.data.date)}>{day(post.data.date)}</time>
        <span>♪ {trackLength(post.body)}</span>
      </span>
    </li>
  ))}
</ol>

<style>
  .tracks {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px dashed var(--line);
  }

  li a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }

  li a:hover {
    color: var(--primary);
  }

  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
  }

  @media (max-width: 40rem) {
    li {
      grid-template-columns: 3rem 1fr;
    }

    .meta {
      grid-column: 2;
    }
  }
</style>
