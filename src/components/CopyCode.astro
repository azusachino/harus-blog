---
// Injects a copy button for code blocks in posts and series chapters.
---
<template id="copy-control">
  <button class="copy-button" type="button" aria-label="Copy code" title="Copy code" data-copy>
    <svg data-icon="copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </svg>
    <svg data-icon="check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5" />
    </svg>
  </button>
</template>
<output id="copy-feedback" class="sr-only" aria-live="polite"></output>

<script>
  function setupCopyButtons() {
    const template = document.querySelector<HTMLTemplateElement>('#copy-control');
    const feedback = document.querySelector<HTMLElement>('#copy-feedback');
    if (!template) return;

    for (const pre of document.querySelectorAll<HTMLElement>('.prose pre')) {
      if (pre.closest('.code-block') || pre.matches('[data-language="mermaid"], .mermaid')) continue;
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.before(wrapper);
      wrapper.append(pre);
      const button = template.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
      wrapper.prepend(button);

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = 'true';
          button.title = 'Code copied';
          button.setAttribute('aria-label', 'Code copied');
          if (feedback) feedback.textContent = 'Code copied.';
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            delete button.dataset.copied;
            button.title = 'Copy code';
            button.setAttribute('aria-label', 'Copy code');
          }, 2000);
        } catch {
          if (feedback) feedback.textContent = 'Clipboard unavailable. Select the code to copy it.';
        }
      });
    }
  }

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
