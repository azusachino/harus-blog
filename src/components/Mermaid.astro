---
// Renders ```mermaid fences. Posts keep plain CommonMark fences; Shiki tags
// them data-language="mermaid", and this script swaps each for a diagram.
// The mermaid library loads only on pages that have one, and diagrams take
// their colors from the site tokens, redrawing on palette or mode change.
// A drawn diagram becomes a viewport: wheel or pinch zooms toward the
// pointer, dragging pans, double-click resets, and a theme redraw starts
// from the fitted view.
---
<script>
  const root = document.documentElement;
  const blocks = [...document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]')];

  if (blocks.length) {
    const figures = blocks.map((pre) => {
      const figure = document.createElement('figure');
      figure.className = 'mermaid-diagram';
      figure.dataset.testid = 'mermaid-diagram';
      figure.dataset.source = pre.textContent ?? '';
      pre.replaceWith(figure);
      return figure;
    });

    const { default: mermaid } = await import('mermaid');
    let id = 0;

    // A redraw replaces the svg, so zoom state restarts; the controller drops
    // the previous listeners instead of stacking a second set on the figure.
    const zooms = new WeakMap<HTMLElement, AbortController>();

    const makeZoomable = (figure: HTMLElement) => {
      zooms.get(figure)?.abort();
      const el = figure.querySelector('svg');
      if (!el) return;
      const ac = new AbortController();
      zooms.set(figure, ac);
      const { signal } = ac;

      let scale = 1;
      let tx = 0;
      let ty = 0;
      let fitW = 0;
      let fitH = 0;

      const clamp = () => {
        tx = scale === 1 ? 0 : Math.min(0, Math.max(fitW * (1 - scale), tx));
        ty = scale === 1 ? 0 : Math.min(0, Math.max(fitH * (1 - scale), ty));
      };
      const apply = () => {
        el.style.transformOrigin = '0 0';
        el.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      };
      const refit = () => {
        el.style.transform = 'none';
        const rect = el.getBoundingClientRect();
        fitW = rect.width;
        fitH = rect.height;
        figure.style.height = `${fitH}px`;
        clamp();
        apply();
      };
      const zoomAt = (px: number, py: number, factor: number) => {
        const next = Math.min(4, Math.max(1, scale * factor));
        if (next === scale) return;
        const k = next / scale;
        tx = px - (px - tx) * k;
        ty = py - (py - ty) * k;
        scale = next;
        clamp();
        apply();
      };

      figure.classList.add('zoomable');
      figure.title = 'Wheel or pinch to zoom, drag to pan, double-click to reset';
      refit();

      const pointers = new Map<number, { x: number; y: number }>();
      let drag: { x: number; y: number; tx: number; ty: number } | null = null;
      let pinch = 0;

      figure.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const rect = figure.getBoundingClientRect();
          zoomAt(e.clientX - rect.left, e.clientY - rect.top, Math.exp(-e.deltaY * 0.0015));
        },
        { passive: false, signal },
      );
      figure.addEventListener(
        'pointerdown',
        (e) => {
          figure.setPointerCapture(e.pointerId);
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
          if (pointers.size === 1) {
            drag = { x: e.clientX, y: e.clientY, tx, ty };
          } else if (pointers.size === 2) {
            drag = null;
            const [a, b] = [...pointers.values()];
            pinch = Math.hypot(a.x - b.x, a.y - b.y);
          }
        },
        { signal },
      );
      figure.addEventListener(
        'pointermove',
        (e) => {
          if (!pointers.has(e.pointerId)) return;
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
          if (drag && pointers.size === 1) {
            tx = drag.tx + e.clientX - drag.x;
            ty = drag.ty + e.clientY - drag.y;
            clamp();
            apply();
          } else if (pointers.size === 2) {
            const [a, b] = [...pointers.values()];
            const dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (pinch > 0) {
              const rect = figure.getBoundingClientRect();
              zoomAt((a.x + b.x) / 2 - rect.left, (a.y + b.y) / 2 - rect.top, dist / pinch);
            }
            pinch = dist;
          }
        },
        { signal },
      );
      const release = (e: PointerEvent) => {
        pointers.delete(e.pointerId);
        pinch = 0;
        const rest = [...pointers.values()];
        drag = rest.length === 1 ? { x: rest[0].x, y: rest[0].y, tx, ty } : null;
      };
      figure.addEventListener('pointerup', release, { signal });
      figure.addEventListener('pointercancel', release, { signal });
      figure.addEventListener(
        'dblclick',
        () => {
          scale = 1;
          tx = 0;
          ty = 0;
          apply();
        },
        { signal },
      );

      const ro = new ResizeObserver(refit);
      ro.observe(figure);
      signal.addEventListener('abort', () => ro.disconnect());
    };

    const render = async () => {
      const css = getComputedStyle(root);
      const token = (name: string) => css.getPropertyValue(name).trim();
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'base',
        fontFamily: token('--font-body'),
        themeVariables: {
          darkMode: root.dataset.theme === 'dark',
          background: token('--surface'),
          primaryColor: token('--surface'),
          primaryTextColor: token('--ink'),
          primaryBorderColor: token('--glow'),
          secondaryColor: token('--bg'),
          tertiaryColor: token('--bg'),
          lineColor: token('--muted'),
          textColor: token('--ink'),
          clusterBkg: token('--bg'),
          clusterBorder: token('--line'),
          edgeLabelBackground: token('--surface'),
          noteBkgColor: token('--surface'),
          noteTextColor: token('--ink'),
          noteBorderColor: token('--glow'),
          actorBkg: token('--surface'),
          actorBorder: token('--glow'),
          actorTextColor: token('--ink'),
          signalColor: token('--ink'),
          signalTextColor: token('--ink'),
        },
      });
      for (const figure of figures) {
        try {
          const { svg } = await mermaid.render(`mermaid-${id++}`, figure.dataset.source ?? '');
          figure.innerHTML = svg;
          figure.classList.remove('failed');
          makeZoomable(figure);
        } catch {
          // Keep the source readable if a diagram does not parse.
          const pre = document.createElement('pre');
          pre.textContent = figure.dataset.source ?? '';
          figure.replaceChildren(pre);
          figure.classList.add('failed');
        }
      }
    };

    await render();
    new MutationObserver(render).observe(root, { attributes: true, attributeFilter: ['data-theme', 'data-palette'] });
  }
</script>

<style is:global>
  .mermaid-diagram {
    margin: 1.6em 0;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-align: center;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }

  .mermaid-diagram.zoomable {
    position: relative;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    cursor: grab;
  }

  .mermaid-diagram.zoomable:active {
    cursor: grabbing;
  }

  .mermaid-diagram.zoomable svg {
    display: block;
  }
</style>
