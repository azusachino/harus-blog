---
// Concert call and response in the footer: cycles through the authentic
// call-and-response vocal phrases from "39みゅーじっく！" (mikitoP).
// The stage calls ("準備OK？", "大サービス！", "大熱唱！", "未体験Night！", "もう一度名前呼んで！"),
// the reader answers ("Yes!", "Oh Yeah!", "Hey!", "Oh Yeah!", "初音ミク！"),
// original song audio plays, and penlights sway.
const sticks = 11;
---
<div class="call">
  <div class="penlights" aria-hidden="true" data-penlights>
    {Array.from({ length: sticks }, (_, i) => <i style={`--i: ${Math.abs(i - (sticks - 1) / 2)}`}></i>)}
  </div>
  <p class="line">
    <span class="ask mono" lang="ja" data-call-ask>準備OK？</span>
    <button class="yes mono" type="button" data-call>Yes!</button>
  </p>
  <p class="visually-hidden" aria-live="polite" data-call-status></p>
</div>

<script is:inline>
  (() => {
    const lights = document.querySelector('[data-penlights]');
    const status = document.querySelector('[data-call-status]');
    const askEl = document.querySelector('[data-call-ask]');
    const btnEl = document.querySelector('[data-call]');
    const caption = document.querySelector('[data-piano-caption]');
    if (!btnEl || !askEl) return;

    // Authentic concert call-and-response audio clips from "39みゅーじっく！" (mikitoP)
    const calls = [
      {
        ask: '準備OK？',
        response: 'Yes!',
        lang: 'en',
        label: '♪ 準備OK？ — Yes! (39みゅーじっく！)',
        status: '準備OK？ Yes! Penlights up!',
        audioSrc: '/audio/39-music/call1-junbi-ok.mp3',
        durationMs: 1520,
      },
      {
        ask: '大サービス！',
        response: 'Oh Yeah!',
        lang: 'en',
        label: '♪ 大サービス！ — Oh Yeah! (39みゅーじっく！)',
        status: '大サービス！ Oh Yeah! Penlights up!',
        audioSrc: '/audio/39-music/call2-dai-service.mp3',
        durationMs: 2500,
      },
      {
        ask: '大熱唱！',
        response: 'Hey!',
        lang: 'en',
        label: '♪ 大熱唱！ — Hey! (39みゅーじっく！)',
        status: '大熱唱！ Hey! Penlights up!',
        audioSrc: '/audio/39-music/call3-dai-nesshou.mp3',
        durationMs: 2200,
      },
      {
        ask: '未体験Night！',
        response: 'Oh Yeah!',
        lang: 'en',
        label: '♪ 未体験Night！ — Oh Yeah! (39みゅーじっく！)',
        status: '未体験Night！ Oh Yeah! Penlights up!',
        audioSrc: '/audio/39-music/call4-mitaiken-night.mp3',
        durationMs: 2150,
      },
      {
        ask: 'もう一度名前呼んで！',
        response: '初音ミク！',
        lang: 'ja',
        label: '♪ もう一度名前呼んで！ — 初音ミク！ (39みゅーじっく！)',
        status: 'もう一度名前呼んで！ 初音ミク！ Penlights up!',
        audioSrc: '/audio/39-music/call5-miku.mp3',
        durationMs: 3850,
      },
    ];

    let current = 0;
    let animTimer;
    let advanceTimer;
    let pendingNext = false;
    let currentAudio = null;

    // Preload audio instances for immediate playback on click
    const audios = calls.map((c) => {
      const a = new Audio(c.audioSrc);
      a.preload = 'auto';
      return a;
    });

    const setCall = (idx) => {
      const item = calls[idx];
      askEl.textContent = item.ask;
      btnEl.textContent = item.response;
      if (item.lang) btnEl.setAttribute('lang', item.lang);
      else btnEl.removeAttribute('lang');
    };

    const advance = () => {
      clearTimeout(advanceTimer);
      current = (current + 1) % calls.length;
      setCall(current);
      pendingNext = false;
    };

    btnEl.addEventListener('click', () => {
      if (pendingNext) {
        advance();
      }

      const activeCall = calls[current];

      // Stop previous phrase audio if still playing
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      }

      // Play original song audio
      const audio = audios[current];
      if (audio) {
        audio.currentTime = 0;
        audio.play().catch(() => {});
        currentAudio = audio;
      }

      // Wave penlights
      if (lights) {
        lights.classList.remove('on');
        void lights.offsetWidth; // restart animation on repeat clicks
        lights.classList.add('on');
      }

      if (caption) caption.textContent = activeCall.label;
      if (status) status.textContent = activeCall.status;

      // Keep penlights up for the phrase duration
      clearTimeout(animTimer);
      const penlightDuration = Math.max(activeCall.durationMs + 500, 2400);
      animTimer = setTimeout(() => {
        lights?.classList.remove('on');
      }, penlightDuration);

      pendingNext = true;
      clearTimeout(advanceTimer);
      advanceTimer = setTimeout(advance, activeCall.durationMs);
    });
  })();
</script>

<style>
  .call {
    margin: 0.2rem auto 0.9rem;
  }

  /* Sticks wait below the edge and rise only when the crowd answers. */
  .penlights {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    height: 3rem;
    overflow: hidden;
  }

  .penlights i {
    position: relative;
    width: 7px;
    height: 2.6rem;
    margin-top: 0.4rem;
    border-radius: 4px 4px 2px 2px;
    /* Same look in both modes, and the same --accent as the piano's lit keys. */
    background: var(--accent);
    --halo: color-mix(in oklab, var(--accent) 70%, transparent);
    transform: translateY(110%);
    transform-origin: 50% 100%;
  }

  /* Grip */
  /* impeccable-disable-next-line side-tab: penlight handle grip */
  .penlights i::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.6rem;
    border-radius: 0 0 2px 2px;
    background: var(--on-glow);
  }

  /* The halo only while raised, so nothing leaks above the edge at rest. */
  .penlights.on i {
    box-shadow: 0 0 11px 2px var(--halo);
    animation: wave 2.4s ease-in-out calc(var(--i) * 45ms) both;
  }

  @keyframes wave {
    0% { transform: translateY(110%) rotate(0deg); }
    14% { transform: translateY(0) rotate(-14deg); }
    32% { transform: translateY(0) rotate(14deg); }
    50% { transform: translateY(0) rotate(-14deg); }
    68% { transform: translateY(0) rotate(14deg); }
    86% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(110%) rotate(0deg); }
  }

  .line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    margin: 0.3rem 0 0;
  }

  .ask {
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .yes {
    font: inherit;
    font-weight: 700;
    color: inherit;
    background: none;
    border: 2px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.9rem;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .yes:hover {
    transform: scale(1.06);
  }

  .yes:active {
    transform: scale(0.96);
  }

  /* Reduced motion: the lights simply show, still, until the timer lowers them. */
  @media (prefers-reduced-motion: reduce) {
    .penlights.on i {
      animation: none;
      transform: none;
    }
  }
</style>
