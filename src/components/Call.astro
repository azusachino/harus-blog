---
// Concert call and response in the footer: one click plays the authentic,
// uncut 39 Music! call-and-response section ("39みゅーじっく！" by mikitoP).
// The stage and crowd call in full song audio: "39みゅーじっく！", "大サービス！" (Oh Yeah!),
// "大熱唱！" (Hey!), "未体験Night！" (Oh Yeah!), "準備OK？" (Yes!), and
// "もう一度名前呼んで！" (初音ミク!), with continuous swaying penlights.
const sticks = 11;
---
<div class="call">
  <div class="penlights" aria-hidden="true" data-penlights>
    {Array.from({ length: sticks }, (_, i) => <i style={`--i: ${Math.abs(i - (sticks - 1) / 2)}`}></i>)}
  </div>
  <p class="line">
    <span class="ask mono" lang="ja" data-call-ask>準備OK？</span>
    <button class="yes mono" type="button" data-call>Yes!</button>
  </p>
  <p class="visually-hidden" aria-live="polite" data-call-status></p>
</div>

<script is:inline>
  (() => {
    const lights = document.querySelector('[data-penlights]');
    const status = document.querySelector('[data-call-status]');
    const askEl = document.querySelector('[data-call-ask]');
    const btnEl = document.querySelector('[data-call]');
    if (!btnEl || !askEl) return;

    // Time-synchronized cues matching the uncut original song section
    const cues = [
      {
        start: 0,
        ask: '39みゅーじっく！',
        response: 'Music!',
        lang: 'en',
        status: '39みゅーじっく！ Music! Penlights up!',
      },
      {
        start: 2.1,
        ask: '大サービス！',
        response: 'Oh Yeah!',
        lang: 'en',
        status: '大サービス！ Oh Yeah!',
      },
      {
        start: 6.2,
        ask: '大熱唱！',
        response: 'Hey!',
        lang: 'en',
        status: '大熱唱！ Hey!',
      },
      {
        start: 11.0,
        ask: '未体験Night！',
        response: 'Oh Yeah!',
        lang: 'en',
        status: '未体験Night！ Oh Yeah!',
      },
      {
        start: 19.8,
        ask: '準備OK？',
        response: 'Yes!',
        lang: 'en',
        status: '準備OK？ Yes!',
      },
      {
        start: 30.6,
        ask: 'もう一度名前呼んで！',
        response: '初音ミク！',
        lang: 'ja',
        status: 'もう一度名前呼んで！ 初音ミク！',
      },
    ];

    const audio = new Audio('/audio/39-music/39-music-concert-call.mp3');
    audio.preload = 'auto';

    let isPlaying = false;
    let currentCue = -1;

    const setCue = (cue) => {
      askEl.textContent = cue.ask;
      btnEl.textContent = cue.response;
      if (cue.lang) btnEl.setAttribute('lang', cue.lang);
      else btnEl.removeAttribute('lang');
      if (status) status.textContent = cue.status;
    };

    audio.addEventListener('timeupdate', () => {
      if (!isPlaying) return;
      const t = audio.currentTime;
      let cueIndex = 0;
      for (let i = cues.length - 1; i >= 0; i--) {
        if (t >= cues[i].start) {
          cueIndex = i;
          break;
        }
      }
      if (cueIndex !== currentCue) {
        currentCue = cueIndex;
        setCue(cues[cueIndex]);
      }
    });

    const stopConcert = () => {
      isPlaying = false;
      audio.pause();
      audio.currentTime = 0;
      currentCue = -1;
      lights?.classList.remove('on');
      btnEl.removeAttribute('aria-pressed');
      askEl.textContent = '準備OK？';
      btnEl.textContent = 'Yes!';
      btnEl.setAttribute('lang', 'en');
      if (status) status.textContent = 'Concert call complete.';
    };

    audio.addEventListener('ended', stopConcert);

    btnEl.addEventListener('click', () => {
      if (isPlaying) {
        stopConcert();
      } else {
        isPlaying = true;
        lights?.classList.add('on');
        btnEl.setAttribute('aria-pressed', 'true');
        currentCue = 0;
        setCue(cues[0]);
        audio.currentTime = 0;
        audio.play().catch(() => {});
      }
    });
  })();
</script>

<style>
  .call {
    margin: 0.2rem auto 0.9rem;
  }

  /* Sticks wait below the edge and rise when the concert starts. */
  .penlights {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    height: 3rem;
    overflow: hidden;
  }

  .penlights i {
    position: relative;
    width: 7px;
    height: 2.6rem;
    margin-top: 0.4rem;
    border-radius: 4px 4px 2px 2px;
    background: var(--accent);
    --halo: color-mix(in oklab, var(--accent) 70%, transparent);
    transform: translateY(110%);
    transform-origin: 50% 100%;
    transition: transform 0.35s ease-out;
  }

  /* Grip */
  /* impeccable-disable-next-line side-tab: penlight handle grip */
  .penlights i::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.6rem;
    border-radius: 0 0 2px 2px;
    background: var(--on-glow);
  }

  /* The halo and continuous sway while the concert plays through. */
  .penlights.on i {
    box-shadow: 0 0 11px 2px var(--halo);
    animation: sway 1.85s ease-in-out calc(var(--i) * 55ms) infinite alternate;
  }

  @keyframes sway {
    0% { transform: translateY(0) rotate(-14deg); }
    100% { transform: translateY(0) rotate(14deg); }
  }

  .line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    margin: 0.3rem 0 0;
  }

  .ask {
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .yes {
    font: inherit;
    font-weight: 700;
    color: inherit;
    background: none;
    border: 2px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.9rem;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .yes:hover {
    transform: scale(1.06);
  }

  .yes:active {
    transform: scale(0.96);
  }

  .yes[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-glow);
    border-color: var(--accent);
  }

  /* Reduced motion: penlights simply raise and stay still while playing. */
  @media (prefers-reduced-motion: reduce) {
    .penlights.on i {
      animation: none;
      transform: translateY(0);
    }
  }
</style>
