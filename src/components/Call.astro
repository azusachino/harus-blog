---
// Concert call and response in the footer: one click triggers the full
// 5-section call-and-response sequence from "39みゅーじっく！" (mikitoP).
// The stage calls ("準備OK？", "大サービス！", "大熱唱！", "未体験Night！", "もう一度名前呼んで！"),
// the audience answers ("Yes!", "Oh Yeah!", "Hey!", "Oh Yeah!", "初音ミク！"),
// original song audio plays seamlessly, and penlights sway continuously.
const sticks = 11;
---
<div class="call">
  <div class="penlights" aria-hidden="true" data-penlights>
    {Array.from({ length: sticks }, (_, i) => <i style={`--i: ${Math.abs(i - (sticks - 1) / 2)}`}></i>)}
  </div>
  <p class="line">
    <span class="ask mono" lang="ja" data-call-ask>準備OK？</span>
    <button class="yes mono" type="button" data-call>Yes!</button>
  </p>
  <p class="visually-hidden" aria-live="polite" data-call-status></p>
</div>

<script is:inline>
  (() => {
    const lights = document.querySelector('[data-penlights]');
    const status = document.querySelector('[data-call-status]');
    const askEl = document.querySelector('[data-call-ask]');
    const btnEl = document.querySelector('[data-call]');
    if (!btnEl || !askEl) return;

    // The 5 authentic concert call-and-response vocal clips from "39みゅーじっく！" (mikitoP)
    const calls = [
      {
        ask: '準備OK？',
        response: 'Yes!',
        lang: 'en',
        status: '準備OK？ Yes! Penlights up!',
        audioSrc: '/audio/39-music/call1-junbi-ok.mp3',
      },
      {
        ask: '大サービス！',
        response: 'Oh Yeah!',
        lang: 'en',
        status: '大サービス！ Oh Yeah!',
        audioSrc: '/audio/39-music/call2-dai-service.mp3',
      },
      {
        ask: '大熱唱！',
        response: 'Hey!',
        lang: 'en',
        status: '大熱唱！ Hey!',
        audioSrc: '/audio/39-music/call3-dai-nesshou.mp3',
      },
      {
        ask: '未体験Night！',
        response: 'Oh Yeah!',
        lang: 'en',
        status: '未体験Night！ Oh Yeah!',
        audioSrc: '/audio/39-music/call4-mitaiken-night.mp3',
      },
      {
        ask: 'もう一度名前呼んで！',
        response: '初音ミク！',
        lang: 'ja',
        status: 'もう一度名前呼んで！ 初音ミク！',
        audioSrc: '/audio/39-music/call5-miku.mp3',
      },
    ];

    let current = 0;
    let isPlaying = false;
    let currentAudio = null;

    // Preload audio objects and wire the continuous chain
    const audios = calls.map((c, i) => {
      const a = new Audio(c.audioSrc);
      a.preload = 'auto';
      a.addEventListener('ended', () => {
        if (!isPlaying) return;
        const next = i + 1;
        if (next < calls.length) {
          playStep(next);
        } else {
          stopConcert();
        }
      });
      return a;
    });

    const setCall = (idx) => {
      const item = calls[idx];
      askEl.textContent = item.ask;
      btnEl.textContent = item.response;
      if (item.lang) btnEl.setAttribute('lang', item.lang);
      else btnEl.removeAttribute('lang');
    };

    const playStep = (idx) => {
      current = idx;
      setCall(idx);
      const item = calls[idx];
      if (status) status.textContent = item.status;
      const audio = audios[idx];
      if (audio) {
        currentAudio = audio;
        audio.currentTime = 0;
        audio.play().catch(() => {});
      }
    };

    const startConcert = () => {
      isPlaying = true;
      lights?.classList.add('on');
      btnEl.setAttribute('aria-pressed', 'true');
      playStep(0);
    };

    const stopConcert = () => {
      isPlaying = false;
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      }
      currentAudio = null;
      lights?.classList.remove('on');
      btnEl.removeAttribute('aria-pressed');
      current = 0;
      setCall(0);
      if (status) status.textContent = 'Concert call complete.';
    };

    btnEl.addEventListener('click', () => {
      if (isPlaying) {
        stopConcert();
      } else {
        startConcert();
      }
    });
  })();
</script>

<style>
  .call {
    margin: 0.2rem auto 0.9rem;
  }

  /* Sticks wait below the edge and rise when the concert starts. */
  .penlights {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    height: 3rem;
    overflow: hidden;
  }

  .penlights i {
    position: relative;
    width: 7px;
    height: 2.6rem;
    margin-top: 0.4rem;
    border-radius: 4px 4px 2px 2px;
    background: var(--accent);
    --halo: color-mix(in oklab, var(--accent) 70%, transparent);
    transform: translateY(110%);
    transform-origin: 50% 100%;
    transition: transform 0.35s ease-out;
  }

  /* Grip */
  /* impeccable-disable-next-line side-tab: penlight handle grip */
  .penlights i::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.6rem;
    border-radius: 0 0 2px 2px;
    background: var(--on-glow);
  }

  /* The halo and continuous sway while the concert plays through. */
  .penlights.on i {
    box-shadow: 0 0 11px 2px var(--halo);
    animation: sway 1.85s ease-in-out calc(var(--i) * 55ms) infinite alternate;
  }

  @keyframes sway {
    0% { transform: translateY(0) rotate(-14deg); }
    100% { transform: translateY(0) rotate(14deg); }
  }

  .line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    margin: 0.3rem 0 0;
  }

  .ask {
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .yes {
    font: inherit;
    font-weight: 700;
    color: inherit;
    background: none;
    border: 2px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.9rem;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .yes:hover {
    transform: scale(1.06);
  }

  .yes:active {
    transform: scale(0.96);
  }

  .yes[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-glow);
    border-color: var(--accent);
  }

  /* Reduced motion: penlights simply raise and stay still while playing. */
  @media (prefers-reduced-motion: reduce) {
    .penlights.on i {
      animation: none;
      transform: translateY(0);
    }
  }
</style>
