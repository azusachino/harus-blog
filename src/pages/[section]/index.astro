---
import Base from '../../layouts/Base.astro';
import LifeShelves from '../../components/LifeShelves.astro';
import PianoRoll from '../../components/PianoRoll.astro';
import PostList from '../../components/PostList.astro';
import Waveform from '../../components/Waveform.astro';
import { published, SECTIONS, type Section } from '../../lib/posts';

export function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as Section;
const posts = await published(section);
const titles: Record<Section, [string, string]> = {
  tech: ['Tech', 'Notes and series on what I build and study'],
  journal: ['Journal', 'Weekly reports, monthly refreshes and yearly reviews'],
  life: ['Life', 'Books, concerts and essays'],
};
const [title, subtitle] = titles[section];
const years = section === 'journal' ? [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))] : [];
const latestYear = years[0];
const latestYearPosts = latestYear ? posts.filter((p) => p.data.date.getUTCFullYear() === latestYear) : [];
const categories = section === 'tech' ? [...new Set(posts.flatMap((p) => p.data.categories))].sort() : [];
---
<Base title={title}>
  <p class="eyebrow">{posts.length} tracks</p>
  <h1>{title}</h1>
  <p class="muted">{subtitle}</p>
  <Waveform seed={section} />

  {(years.length > 0 || categories.length > 0 || section === 'life') && (
    <nav class="chips" aria-label={years.length ? 'Years' : categories.length ? 'Categories' : 'Explore'}>
      {years.map((y) => <a href={`/journal/archive/${y}/`}>{y}</a>)}
      {categories.map((c) => <a href={`/tech/category/${c}/`}>{c}</a>)}
      {section === 'tech' && <a class="series" href="/tech/series/">series →</a>}
      {section === 'life' && <a class="series" href="/travel/">travel atlas →</a>}
    </nav>
  )}

  {section === 'journal' && latestYear && <PianoRoll year={latestYear} posts={latestYearPosts} />}
  {section === 'life' && <LifeShelves posts={posts} />}

  <PostList section={section} posts={posts} />
</Base>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.2rem 0 1.5rem;
  }

  .chips a {
    padding: 0.2rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  p.muted {
    text-wrap: pretty;
  }

  .chips a:hover {
    border-color: var(--glow);
  }

  .chips .series {
    border-color: var(--glow);
  }
</style>
