---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Waveform from '../components/Waveform.astro';

const items = await getCollection('use');
const groups = [
  { id: 'dev', title: 'Dev' },
  { id: 'devices', title: 'Devices' },
  { id: 'subscriptions', title: 'Subscriptions' },
] as const;
---
<Base title="Use" description="Things I use: tools, devices and subscriptions.">
  <p class="eyebrow">Equipment rack</p>
  <h1>Use</h1>
  <p class="muted">Tools, devices and services I actually use.</p>
  <Waveform seed="use" />

  <nav class="chips" aria-label="Groups">
    {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
  </nav>

  {groups.map((g) => {
    const rows = items.filter((i) => i.data.group === g.id);
    return (
      <section class="rack" aria-labelledby={g.id}>
        <h2 id={g.id}>{g.title}</h2>
        {rows.length === 0 ? (
          <p class="muted">Nothing here yet.</p>
        ) : (
          <table>
            <thead>
              <tr><th>Type</th><th>Name</th><th>Note</th></tr>
            </thead>
            <tbody>
              {rows.map(({ data }) => (
                <tr>
                  <td data-label="Type">{data.kind}</td>
                  <td data-label="Name">{data.url ? <a href={data.url}>{data.name}</a> : data.name}</td>
                  <td data-label="Note" class:list={['muted', { empty: !data.note }]}>{data.note ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    );
  })}
</Base>

<style>
  .chips {
    display: flex;
    gap: 0.6rem;
    margin: 1.5rem 0 1rem;
    flex-wrap: wrap;
  }

  .chips a {
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .chips a:hover {
    border-color: var(--glow);
  }

  .rack {
    margin-top: 2.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    font-size: 0.92rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 2px solid var(--glow);
  }

  @media (max-width: 40rem) {
    thead {
      display: none;
    }

    table,
    tbody,
    tr,
    td {
      display: block;
    }

    tr {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--line);
    }

    td {
      border: 0;
      padding: 0.15rem 0.9rem;
    }

    td.empty {
      display: none;
    }

    td::before {
      content: attr(data-label);
      display: inline-block;
      width: 4.5rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--muted);
      text-transform: uppercase;
    }
  }
</style>
