---
// Series as albums: each tutorial set with its chapters in order, styled like
// a CD/vinyl record back cover with track numbers and durations.
import Base from '../../../layouts/Base.astro';
import Waveform from '../../../components/Waveform.astro';
import { albumHref, seriesAlbums, seriesHref, trackLength } from '../../../lib/posts';

const albums = await seriesAlbums();
const tracks = albums.reduce((n, a) => n + a.chapters.length, 0);
---
<Base title="Series" description="Ordered tutorial series, read like albums.">
  <p class="eyebrow">{albums.length} albums · {tracks} tracks</p>
  <h1>Series</h1>
  <p class="muted">Ordered tutorials, sequenced like albums with chapter runtimes.</p>
  <Waveform seed="series" />

  <div class="grid">
    {albums.map((album, idx) => (
      <section class="card album" aria-labelledby={album.dir}>
        <header class="album-head">
          <p class="eyebrow">
            <span>DISC {String(idx + 1).padStart(2, '0')}</span>
            <span class="mono muted">{album.chapters.length} tracks · ∑ ♪ {album.totalLength}</span>
          </p>
          <h2 id={album.dir}>
            <a href={albumHref(album.dir)}>{album.name}</a>
          </h2>
          {album.description && <p class="album-desc muted">{album.description}</p>}
          <Waveform seed={album.dir} bars={28} />
        </header>

        <ol class="tracklist">
          {album.chapters.slice(0, 3).map((c, i) => (
            <li>
              <span class="no mono">{String(i + 1).padStart(2, '0')}</span>
              <a href={seriesHref(c.id)}>{c.data.title.replace(/^.*?\d+\s*-\s*/, '')}</a>
              <span class="dur mono muted">{trackLength(c.body)}</span>
            </li>
          ))}
        </ol>

        <footer class="album-footer">
          <a class="album-link mono" href={albumHref(album.dir)}>
            {album.chapters.length > 3 ? `查看全部 ${album.chapters.length} 篇 →` : '进入专辑 →'}
          </a>
        </footer>
      </section>
    ))}
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .album {
    border-top: 3px solid var(--glow);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .album:hover {
    border-top-color: var(--primary);
  }

  .album-head {
    flex-shrink: 0;
  }

  .album-head .eyebrow {
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .album-head .eyebrow span {
    white-space: nowrap;
  }

  h2 {
    margin: 0.35rem 0 0.25rem;
    font-size: 1.2rem;
    text-wrap: balance;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  h2 a:hover {
    color: var(--primary);
  }

  .album-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0.2rem 0 0.6rem;
  }

  .tracklist {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .tracklist li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .tracklist .no {
    color: var(--primary);
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .tracklist a {
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
  }

  .tracklist a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .tracklist .dur {
    font-size: 0.78rem;
    flex-shrink: 0;
  }

  .album-footer {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
  }

  .album-link {
    font-size: 0.85rem;
    color: var(--primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }

  .album-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
