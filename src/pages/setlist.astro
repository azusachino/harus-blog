---
import Base from '../layouts/Base.astro';
import { day, href, published, SECTIONS, trackLength } from '../lib/posts';

// Every published post as one note: its section lane, date, and track length in seconds.
const names = { tech: 'Tech', journal: 'Journal', life: 'Life' };
const tracks = (
  await Promise.all(
    SECTIONS.map(async (section) =>
      (await published(section)).map((post) => {
        const [m, s] = trackLength(post.body).split(':').map(Number);
        return {
          lane: section,
          title: post.data.title,
          href: href(section, post),
          day: day(post.data.date),
          time: post.data.date.getTime(),
          seconds: m * 60 + s,
          label: trackLength(post.body),
        };
      }),
    ),
  )
).flat();
const lanes = SECTIONS.map((s) => ({ id: s, name: names[s] }));
---
<Base title="Setlist" description="Every post as a note on one timeline: lane by section, height by track length.">
  <header class="intro">
    <p class="eyebrow">{tracks.length} tracks · {lanes.map((l) => l.name).join(' / ')}</p>
    <h1>Setlist</h1>
    <p class="muted">Every post on one timeline. Height is the track length, the brightest note is the newest release.</p>
  </header>

  <figure class="setlist">
    <div id="setlist-chart" class="chart"></div>
    <p class="readout mono" aria-live="polite" id="setlist-readout">Hover or tab through a track.</p>
  </figure>

  <script id="setlist-data" type="application/json" set:html={JSON.stringify({ tracks, lanes })}></script>
  <script>
    import { scaleLinear, scaleTime } from 'd3-scale';
    import { select } from 'd3-selection';
    import 'd3-transition';

    const { tracks, lanes } = JSON.parse(document.getElementById('setlist-data')!.textContent!);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dur = (ms: number) => (reduced ? 0 : ms);

    // One shared axis: x is time, y is seconds, the same scale in every lane.
    const W = 960;
    const laneH = 110;
    const top = 26;
    const labelW = 84;
    const H = top + lanes.length * laneH + 22;
    const x = scaleTime()
      .domain([new Date(Math.min(...tracks.map((t: { time: number }) => t.time))), new Date(Math.max(...tracks.map((t: { time: number }) => t.time)))])
      .range([labelW, W - 14]);
    const y = scaleLinear()
      .domain([0, Math.max(...tracks.map((t: { seconds: number }) => t.seconds))])
      .range([0, laneH - 16]);
    const newest = tracks.reduce((a: { time: number }, b: { time: number }) => (b.time > a.time ? b : a));

    const svg = select('#setlist-chart')
      .append('svg')
      .attr('viewBox', `0 0 ${W} ${H}`)
      .attr('role', 'img')
      .attr('aria-label', 'Posts by date in lanes for Tech, Journal and Life, bar height is track length');

    // Year ticks along the bottom, one quiet line each.
    svg
      .append('g')
      .selectAll('text')
      .data(x.ticks(6))
      .join('text')
      .attr('x', (d) => x(d))
      .attr('y', H - 4)
      .attr('text-anchor', 'middle')
      .attr('class', 'tick')
      .text((d) => d.getFullYear());

    const readout = document.getElementById('setlist-readout')!;
    const show = (t: { title: string; day: string; label: string }) => {
      readout.textContent = `♪ ${t.title} · ${t.day} · ${t.label}`;
    };

    lanes.forEach((lane: { id: string; name: string }, i: number) => {
      const base = top + (i + 1) * laneH - 10;
      svg.append('text').attr('x', 0).attr('y', base - 4).attr('class', 'lane').text(lane.name);
      svg
        .append('line')
        .attr('x1', labelW)
        .attr('x2', W - 14)
        .attr('y1', base)
        .attr('y2', base)
        .attr('class', 'baseline');

      tracks
        .filter((t: { lane: string }) => t.lane === lane.id)
        .forEach((t: { title: string; href: string; day: string; label: string; seconds: number; time: number }, j: number) => {
          const cx = x(new Date(t.time));
          const h = y(t.seconds);
          const link = svg.append('a').attr('href', t.href).attr('class', 'note');
          // A wider invisible hit area, so the 3px bar is easy to point at.
          link.append('rect').attr('x', cx - 7).attr('y', base - laneH + 16).attr('width', 14).attr('height', laneH - 16).attr('class', 'hit');
          link
            .append('rect')
            .attr('x', cx - 1.5)
            .attr('y', base)
            .attr('width', 3)
            .attr('height', 0)
            .attr('rx', 1.5)
            .attr('class', t.time === newest.time ? 'bar newest' : 'bar')
            .transition()
            .delay(dur(j * 18))
            .duration(dur(700))
            .attr('y', base - h)
            .attr('height', h);
          link
            .on('mouseenter focus', () => show(t))
            .append('title')
            .text(`${t.title} · ${t.day} · ${t.label}`);
        });
    });

    // The playhead sweeps once across the timeline, then leaves.
    if (!reduced) {
      const head = svg.append('line').attr('x1', labelW).attr('x2', labelW).attr('y1', top - 8).attr('y2', H - 22).attr('class', 'head');
      head.transition().duration(2400).attr('x1', W - 14).attr('x2', W - 14).remove();
    }
  </script>
</Base>

<style>
  .intro {
    padding: 1.5rem 0 1rem;
  }

  .setlist {
    margin: 0 0 2rem;
  }

  .chart {
    width: 100%;
  }

  .chart :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart :global(.lane) {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chart :global(.tick) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--muted);
  }

  .chart :global(.baseline) {
    stroke: var(--line);
    stroke-width: 1;
  }

  .chart :global(.head) {
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .chart :global(.bar) {
    fill: var(--primary);
  }

  .chart :global(.newest) {
    fill: var(--accent);
  }

  .chart :global(.hit) {
    fill: transparent;
  }

  .chart :global(.note) {
    outline: none;
  }

  .chart :global(.note:focus-visible .bar),
  .chart :global(.note:hover .bar) {
    fill: var(--glow);
  }

  .chart :global(.note:focus-visible .newest),
  .chart :global(.note:hover .newest) {
    fill: var(--accent);
  }

  .readout {
    min-height: 1.5em;
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    color: var(--ink);
  }
</style>
