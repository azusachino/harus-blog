---
import Base from '../layouts/Base.astro';
import { day, href, published, SECTIONS, trackLength } from '../lib/posts';

// Posts are stars. Two posts are linked when their titles share a topic word
// (kubernetes, rocksdb, ...) that appears in at least two and at most eight
// posts, so hub words do not turn the sky into a hairball.
const STOP = new Set(['about', 'with', 'from', 'into', 'your', 'what', 'when', 'where', 'this', 'that', 'there', 'their', 'build', 'part']);
const words = (title: string) =>
  new Set((title.toLowerCase().match(/[a-z][a-z0-9+#]{3,}/g) ?? []).filter((w) => !STOP.has(w)));

const posts = (await Promise.all(SECTIONS.map(async (section) => (await published(section)).map((post) => ({ section, post }))))).flat();
const nodes = posts.map(({ section, post }) => {
  const [m, s] = trackLength(post.body).split(':').map(Number);
  return {
    id: `${section}/${post.data.slug}`,
    title: post.data.title,
    href: href(section, post),
    day: day(post.data.date),
    label: trackLength(post.body),
    seconds: m * 60 + s,
    words: [...words(post.data.title)],
  };
});

const byWord = new Map<string, string[]>();
for (const n of nodes) for (const w of n.words) byWord.set(w, [...(byWord.get(w) ?? []), n.id]);
const seen = new Set<string>();
const links: { source: string; target: string; word: string }[] = [];
for (const [word, ids] of byWord) {
  if (ids.length < 2 || ids.length > 8) continue;
  for (let i = 0; i < ids.length; i++)
    for (let j = i + 1; j < ids.length; j++) {
      const key = [ids[i], ids[j]].sort().join('|');
      if (seen.has(key)) continue;
      seen.add(key);
      links.push({ source: ids[i], target: ids[j], word });
    }
}
const graph = { nodes: nodes.map(({ words: _w, ...n }) => n), links };
---
<Base title="Constellation" description="Posts as stars: a link means two titles share a topic word.">
  <header class="intro">
    <p class="eyebrow">{graph.nodes.length} stars · {links.length} links</p>
    <h1>Constellation</h1>
    <p class="muted">
      Drag a star, hover one to see its neighbours. A line means the two titles share a word like{' '}
      <span class="mono">kafka</span> or <span class="mono">rocksdb</span>. Stars with no shared word drift alone.
    </p>
  </header>

  <figure class="sky">
    <div id="sky" class="canvas"></div>
    <p class="readout mono" id="sky-readout" aria-live="polite">Hover a star.</p>
  </figure>

  <script id="sky-data" type="application/json" set:html={JSON.stringify(graph)}></script>
  <script>
    import { forceCenter, forceCollide, forceLink, forceManyBody, forceSimulation } from 'd3-force';
    import { drag } from 'd3-drag';
    import { select } from 'd3-selection';

    const { nodes, links } = JSON.parse(document.getElementById('sky-data')!.textContent!);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const W = 960;
    const H = 560;
    const readout = document.getElementById('sky-readout')!;

    // Radius follows track length, so long posts are bigger stars.
    const r = (d: { seconds: number }) => 4 + Math.sqrt(d.seconds) * 0.45;
    const neighbours = new Map<string, Set<string>>();
    for (const l of links) {
      neighbours.set(l.source, (neighbours.get(l.source) ?? new Set()).add(l.target));
      neighbours.set(l.target, (neighbours.get(l.target) ?? new Set()).add(l.source));
    }

    const svg = select('#sky')
      .append('svg')
      .attr('viewBox', `0 0 ${W} ${H}`)
      .attr('role', 'img')
      .attr('aria-label', 'Force-directed graph of posts linked by shared title words');

    const sim = forceSimulation(nodes)
      .force('link', forceLink(links).id((d: any) => d.id).distance(90).strength(0.4))
      .force('charge', forceManyBody().strength(-70))
      .force('center', forceCenter(W / 2, H / 2))
      .force('collide', forceCollide().radius((d: any) => r(d) + 3));

    const link = svg.append('g').selectAll('line').data(links).join('line').attr('class', 'thread');
    const node = svg
      .append('g')
      .selectAll('a')
      .data(nodes)
      .join('a')
      .attr('href', (d: any) => d.href)
      .attr('class', 'star')
      .attr('aria-label', (d: any) => `${d.title}, ${d.day}`);
    node.append('circle').attr('r', (d: any) => r(d));
    node.append('title').text((d: any) => d.title);

    const show = (d: any) => {
      readout.textContent = `✦ ${d.title} · ${d.day} · ${d.label}`;
      const near = neighbours.get(d.id) ?? new Set();
      node.classed('dim', (n: any) => n !== d && !near.has(n.id));
      link.classed('lit', (l: any) => l.source.id === d.id || l.target.id === d.id);
    };
    const clear = () => {
      node.classed('dim', false);
      link.classed('lit', false);
    };

    node
      .on('mouseenter focus', (_e: Event, d: any) => show(d))
      .on('mouseleave blur', clear);

    const tick = () => {
      link
        .attr('x1', (d: any) => d.source.x)
        .attr('y1', (d: any) => d.source.y)
        .attr('x2', (d: any) => d.target.x)
        .attr('y2', (d: any) => d.target.y);
      node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
    };

    // Reduced motion: settle the layout up front and draw the final frame.
    if (reduced) {
      sim.stop();
      for (let i = 0; i < 300; i++) sim.tick();
      tick();
    } else {
      sim.on('tick', tick);
    }

    // Dragging pins a star where it is dropped; the others keep settling.
    node.call(
      drag<SVGAElement, any>()
        .on('start', (event, d) => {
          if (!event.active) sim.alphaTarget(0.3).restart();
          d.fx = d.x;
          d.fy = d.y;
        })
        .on('drag', (event, d) => {
          d.fx = event.x;
          d.fy = event.y;
        })
        .on('end', (event, d) => {
          if (!event.active) sim.alphaTarget(0);
          d.fx = null;
          d.fy = null;
        }) as any,
    );
  </script>
</Base>

<style>
  .intro {
    padding: 1.5rem 0 1rem;
  }

  .sky {
    margin: 0 0 2rem;
  }

  .canvas :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }

  .canvas :global(.thread) {
    stroke: var(--line);
    stroke-width: 1;
    transition: stroke 0.2s ease, opacity 0.2s ease;
  }

  .canvas :global(.thread.lit) {
    stroke: var(--glow);
    stroke-width: 2;
  }

  .canvas :global(.star) {
    cursor: grab;
    outline: none;
    transition: opacity 0.2s ease;
  }

  .canvas :global(.star circle) {
    fill: var(--primary);
    stroke: var(--surface);
    stroke-width: 2;
  }

  .canvas :global(.star:focus-visible circle),
  .canvas :global(.star:hover circle) {
    fill: var(--accent);
  }

  .canvas :global(.star.dim) {
    opacity: 0.2;
  }

  .readout {
    min-height: 1.5em;
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    color: var(--ink);
  }
</style>
