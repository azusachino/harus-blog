---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Playlist from '../components/Playlist.astro';
import Sequencer from '../components/Sequencer.astro';
import Waveform from '../components/Waveform.astro';
import { githubActivity } from '../lib/github';
import { day } from '../lib/posts';

const entries = await getCollection('currently');
const updated = new Date(Math.max(...entries.map((e) => e.data.updated.getTime())));
const gh = await githubActivity();
// Use: one compact row per kind ("Coding agent: Claude Code · Pi · ..."), grouped as in use.yaml.
const gear = await getCollection('use');
const useGroups = [
  { id: 'dev', title: 'Dev' },
  { id: 'devices', title: 'Devices' },
  { id: 'subscriptions', title: 'Subscriptions' },
].map((g) => {
  const rows = new Map<string, typeof gear>();
  for (const i of gear.filter((i) => i.data.group === g.id)) rows.set(i.data.kind, [...(rows.get(i.data.kind) ?? []), i]);
  return { ...g, rows: [...rows] };
});
const of = (section: string) => entries.filter((e) => e.data.section === section);
const sections = [
  { id: 'play', title: 'Play', items: of('play') },
  { id: 'practice', title: 'Practice', items: of('practice') },
  { id: 'listen', title: 'Listen' },
  { id: 'read-watch', title: 'Read & watch', items: of('read-watch') },
  { id: 'use', title: 'Use' },
  { id: 'build', title: 'Build' },
];
---
<Base title="Currently" description="What I'm playing, practicing, listening to, reading, using and building.">
  <p class="eyebrow">Updated {day(updated)}</p>
  <h1>Currently</h1>
  <p class="muted">What I'm playing, practicing, listening to, reading, using and building.</p>
  <Waveform seed="currently" />

  <nav class="chips" aria-label="Sections">
    {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
  </nav>

  {sections.map((s) => (
    <section class="block" aria-labelledby={s.id}>
      <h2 id={s.id}>{s.title}</h2>

      {s.items && (s.items.length === 0 ? <p class="muted">Nothing right now.</p> : (
        <ul class="deck">
          {s.items.map(({ data }) => (
            <li class="card">
              <p class="eyebrow">{data.kind}</p>
              <p class="value">{data.url ? <a href={data.url}>{data.value}</a> : data.value}</p>
              {data.detail && <p class="detail muted">{data.detail}</p>}
              <p class="mono muted stamp">{day(data.updated)}</p>
            </li>
          ))}
        </ul>
      ))}

      {s.id === 'listen' && <div class="repeat"><p class="eyebrow">On repeat</p><Playlist /></div>}

      {s.id === 'use' && (
        <div class="use">
          {useGroups.map((g) => (
            <dl>
              <dt class="eyebrow group">{g.title}</dt>
              {g.rows.map(([kind, list]) => (
                <>
                  <dt class="mono kind">{kind}</dt>
                  <dd>
                    {list.map(({ data }, n) => (
                      <>
                        {n > 0 && ' · '}
                        {data.url ? <a href={data.url}>{data.name}</a> : data.name}
                        {data.note && <span class="muted"> ({data.note.replace(/\.$/, '')})</span>}
                      </>
                    ))}
                  </dd>
                </>
              ))}
            </dl>
          ))}
        </div>
      )}

      {s.id === 'build' && (gh ? (
        <>
          <p class="muted">Public GitHub activity, last {gh.days.length} days. Fetched at build time {gh.fetched.slice(0, 16).replace('T', ' ')} UTC.</p>
          <Sequencer days={gh.days} />
          <div class="cols">
            <div>
              <h3 class="eyebrow">Recently pushed</h3>
              <ul class="plain">
                {gh.repos.map((r) => (
                  <li>
                    <a href={r.url}>{r.name}</a>
                    <span class="mono muted">{r.language ?? ''} · {r.pushed.slice(0, 10)}</span>
                    {r.description && <p class="muted small">{r.description}</p>}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="eyebrow">Recently merged</h3>
              <ul class="plain">
                {gh.merged.map((m) => (
                  <li>
                    <a href={m.url}>{m.repo}#{m.number}</a>
                    <span class="mono muted">{m.date}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </>
      ) : (
        <p class="card muted">GitHub activity was unavailable when this page was built. It returns on the next rebuild.</p>
      ))}
    </section>
  ))}
</Base>

<style>
  .chips {
    display: flex;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    flex-wrap: wrap;
  }

  .chips a {
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  p.muted {
    text-wrap: pretty;
  }

  .chips a:hover {
    border-color: var(--glow);
  }

  .block {
    margin-top: 2.8rem;
  }

  .deck {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .deck .card {
    border-top: 3px solid var(--glow);
  }

  .deck p {
    margin: 0;
  }

  .value {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0.2rem 0 !important;
    text-wrap: balance;
  }

  .detail {
    font-size: 0.9rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .stamp {
    font-size: 0.72rem;
    margin-top: 0.6rem !important;
    white-space: nowrap;
  }

  .use {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem 2.5rem;
    margin-top: 1rem;
  }

  .use dl {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .use dt.group {
    margin: 0 0 0.4rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--glow);
  }

  .use .kind {
    margin-top: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .use dd {
    margin: 0;
  }

  .repeat {
    max-width: 36rem;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .plain li {
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--line);
  }

  .plain .mono {
    font-size: 0.75rem;
    margin-left: 0.6rem;
    white-space: nowrap;
  }

  .small {
    font-size: 0.85rem;
    margin: 0.2rem 0 0;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
