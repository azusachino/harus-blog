---
// CV: a component page over src/data/cv.yaml, the same source as the PDF
// (assets/cv/cv.typ). Roles are a tracklist: each <details> row expands to its
// bullets, the current role starts open. No script; native disclosure only.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Waveform from '../components/Waveform.astro';

type Link = { text: string; href: string };
type Bullet = string | { text: string; link: Link };
type Project = { name: string; tag: string; href?: string; text: string };

const data = async <T,>(id: string) => (await getEntry('cv', id))!.data as T;
const profile = await data<{
  updated: string;
  name: string;
  headline: string;
  email: string;
  phones: string[];
  born: string;
  github: string;
  linkedin: string;
  summary: string;
}>('profile');
const experience = await data<{
  title: string;
  roles: { title: string; org: string; period: string; bullets: Bullet[] }[];
}>('experience');
const agents = await data<{ title: string; projects: Project[] }>('agents');
const systems = await data<{ title: string; projects: Project[] }>('systems');
const skills = await data<{ title: string; rows: { label: string; value: string; href?: string }[] }>('skills');

// Splits a linked bullet around its link text: [before, link, after].
const parts = (b: Bullet) => {
  if (typeof b === 'string') return { before: b };
  const at = b.text.indexOf(b.link.text);
  return { before: b.text.slice(0, at), link: b.link, after: b.text.slice(at + b.link.text.length) };
};
const track = (n: number) => `#${String(n).padStart(2, '0')}`;
const host = (url: string) => url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');

const sections = [
  { id: 'experience', title: experience.title },
  { id: 'agents', title: agents.title },
  { id: 'systems', title: systems.title },
  { id: 'skills', title: skills.title },
];
const projectSections = [
  { id: 'agents', ...agents },
  { id: 'systems', ...systems },
];
---
<Base title="CV" description="True Persona">
  <article class="cv" lang="en">
    <header class="intro">
      <p class="eyebrow">Updated <time datetime={profile.updated}>{profile.updated}</time></p>
      <h1>{profile.name}</h1>
      <p class="headline mono">{profile.headline}</p>
      <dl class="contact">
        <div><dt class="eyebrow">Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
        <div><dt class="eyebrow">GitHub</dt><dd><a href={profile.github}>{host(profile.github)}</a></dd></div>
        <div><dt class="eyebrow">LinkedIn</dt><dd><a href={profile.linkedin}>{host(profile.linkedin)}</a></dd></div>
        <div><dt class="eyebrow">Phone</dt><dd class="mono">{profile.phones.map((p) => <span>{p}</span>)}</dd></div>
        <div><dt class="eyebrow">Born</dt><dd class="mono">{profile.born}</dd></div>
      </dl>
      <a class="download" href="/cv.pdf" download>Download PDF <span aria-hidden="true">↓</span></a>
      <Waveform seed="cv" />
    </header>

    <p class="lead">{profile.summary}</p>

    <nav class="chips" aria-label="Sections">
      {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>

    <section aria-labelledby="experience">
      <h2 id="experience">{experience.title}</h2>
      <ol class="tracks">
        {experience.roles.map((r, i) => (
          <li>
            <details open={i === 0}>
              <summary>
                <span class="badge">{track(i + 1)}</span>
                <span class="role">
                  <span class="org">{r.org}</span>
                  <span class="title muted">{r.title}</span>
                </span>
                <span class="period mono muted">{r.period}</span>
                <span class="chev" aria-hidden="true">▸</span>
              </summary>
              {r.bullets.length > 0 && (
                <ul class="bullets">
                  {r.bullets.map((b) => {
                    const { before, link, after } = parts(b);
                    return <li>{before}{link && <a href={link.href}>{link.text}</a>}{after}</li>;
                  })}
                </ul>
              )}
            </details>
          </li>
        ))}
      </ol>
    </section>

    {projectSections.map((s) => (
      <section aria-labelledby={s.id}>
        <h2 id={s.id}>{s.title}</h2>
        <ul class="projects">
          {s.projects.map((p) => (
            <li class="card">
              <div class="card-head">
                {p.href ? (
                  <a class="name" href={p.href}>{p.name}<span class="ext" aria-hidden="true"> ↗</span></a>
                ) : (
                  <span class="name">{p.name}</span>
                )}
                <span class="tag mono muted">{p.tag}</span>
              </div>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="skills">
      <h2 id="skills">{skills.title}</h2>
      <dl class="skills">
        {skills.rows.map((r) => (
          <>
            <dt class="eyebrow">{r.label}</dt>
            <dd>{r.href ? <a href={r.href}>{r.value}</a> : r.value}</dd>
          </>
        ))}
      </dl>
    </section>
  </article>
</Base>

<style>
  .cv {
    max-width: 52rem;
    margin-inline: auto;
  }

  .intro h1 {
    margin: 0.3rem 0 0.2rem;
  }

  .headline {
    margin: 0;
    color: var(--primary);
    font-size: 0.9rem;
  }

  /* Label above value, one cell each, so links and plain text never share a line. */
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 1.1rem 0 1.3rem;
    font-size: 0.92rem;
  }

  .contact dd {
    margin: 0.2rem 0 0;
    display: flex;
    flex-direction: column;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--primary);
    color: var(--on-accent);
    padding: 0.5rem 1.05rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .download:hover {
    background: var(--accent);
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 1.6rem 0 0;
  }

  .chips {
    display: flex;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    flex-wrap: wrap;
  }

  .chips a {
    padding: 0.25rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .chips a:hover {
    border-color: var(--glow);
    color: var(--primary);
  }

  section {
    margin-top: 2.6rem;
    scroll-margin-top: 1rem;
  }

  /* Tracklist: same row language as PostList, but each row discloses. */
  .tracks {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tracks > li {
    border-bottom: 1px dashed var(--line);
  }

  summary {
    display: grid;
    grid-template-columns: 3rem 1fr auto 1.2rem;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.8rem 0.6rem;
    border-radius: 6px;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.2s ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover,
  summary:focus-visible {
    background-color: color-mix(in srgb, var(--glow) 12%, var(--surface));
  }

  summary:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  details[open] > summary .badge,
  summary:hover .badge {
    color: var(--accent);
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .org {
    font-weight: 600;
    color: var(--ink);
  }

  .title {
    font-size: 0.9rem;
  }

  .period {
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .chev {
    color: var(--muted);
    transition: transform 0.2s ease;
  }

  details[open] > summary .chev {
    transform: rotate(90deg);
    color: var(--primary);
  }

  .bullets {
    margin: 0.2rem 0 1.1rem;
    padding: 0 0.6rem 0 4.35rem;
    line-height: 1.65;
  }

  .bullets li + li {
    margin-top: 0.45rem;
  }

  .bullets li::marker {
    color: var(--glow);
  }

  @media (prefers-reduced-motion: reduce) {
    summary,
    .chev {
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    summary {
      grid-template-columns: 2.6rem 1fr 1.2rem;
    }

    .period {
      grid-column: 2;
      grid-row: 2;
    }

    .chev {
      grid-column: 3;
      grid-row: 1;
    }

    .bullets {
      padding-left: 1.6rem;
    }
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .name {
    font-weight: 600;
  }

  a.name {
    text-decoration: none;
  }

  .tag {
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .card p {
    margin: 0.5rem 0 0;
    line-height: 1.6;
  }

  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.7rem 1.4rem;
    margin: 0;
  }

  .skills dt {
    padding-top: 0.2rem;
  }

  .skills dd {
    margin: 0;
  }

  @media (max-width: 40rem) {
    .skills {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .skills dd {
      margin-bottom: 0.7rem;
    }
  }
</style>
