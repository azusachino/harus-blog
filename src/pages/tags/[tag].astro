---
import Base from '../../layouts/Base.astro';
import Waveform from '../../components/Waveform.astro';
import { day, taggedTracks, trackLength, type TaggedTrack } from '../../lib/posts';

export async function getStaticPaths() {
  const byTag = new Map<string, TaggedTrack[]>();
  for (const track of await taggedTracks()) {
    for (const tag of track.tags) {
      byTag.set(tag, [...(byTag.get(tag) ?? []), track]);
    }
  }
  return [...byTag.entries()].map(([tag, items]) => ({
    params: { tag },
    props: {
      tag,
      items: items.sort((a, b) => b.created.getTime() - a.created.getTime() || a.href.localeCompare(b.href)),
    },
  }));
}

const { tag, items } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged #${tag}.`}>
  <p class="eyebrow">
    <a href="/tags/">Tags</a>
    <span class="mono muted">{items.length} tracks</span>
  </p>
  <h1>#{tag}</h1>
  <Waveform seed={`tag-${tag}`} />

  <ol class="tracks">
    {items.map((track, i) => (
      <li lang={track.lang}>
        <span class="no mono">{String(items.length - i).padStart(2, '0')}</span>
        <div class="main">
          <a class="title" href={track.href}>{track.title}</a>
          {track.description && <p class="desc muted">{track.description}</p>}
        </div>
        <span class="meta mono muted">
          <span class="sec">{track.label}</span>
          <time datetime={day(track.created)}>{day(track.created)}</time>
          <span>♪ {trackLength(track.body)}</span>
        </span>
      </li>
    ))}
  </ol>
</Base>

<style>
  .eyebrow {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
  }

  .tracks {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .tracks li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 0.85rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 6px;
    border-bottom: 1px solid var(--line);
  }

  .tracks li:hover {
    background: var(--surface);
  }

  .no {
    color: var(--glow);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .title {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    text-wrap: balance;
  }

  .title:hover {
    color: var(--primary);
  }

  .desc {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .sec {
    color: var(--primary);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .tracks li {
      grid-template-columns: 2.2rem minmax(0, 1fr);
    }

    .meta {
      grid-column: 2;
    }
  }
</style>
