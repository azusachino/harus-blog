---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
---
<Base title="Track not found">
  <section class="lost">
    <div class="art"><Illustration name="not-found" eager /></div>
    <p class="badge">404</p>
    <h1>Track not found</h1>
    <p class="muted">This track is empty. Maybe it was renamed, maybe it was never recorded.</p>
    <p><a href="/">← back to the playlist</a></p>
    <p class="negi" aria-hidden="true" title="ネギ">🌱</p>
  </section>
</Base>

<style>
  .lost {
    text-align: center;
    padding: 1rem 0 3rem;
  }

  .art {
    max-width: 26rem;
    margin: 0 auto 1.5rem;
  }

  .negi {
    opacity: 0.35;
    font-size: 0.9rem;
  }
</style>
