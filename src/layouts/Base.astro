---
import BackToTop from '../components/BackToTop.astro';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import Call from '../components/Call.astro';
import { PALETTES, SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  progress?: boolean;
}
const { title, description, image, article = false, progress = false } = Astro.props;
// Same "<page> - <site>" format as Material: Giscus maps comments by title.
const full = title === SITE.title ? SITE.title : `${title} - ${SITE.title}`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const metaDesc = description || SITE.description;
const metaImage = image ? new URL(image, SITE.url).href : new URL('/apple-touch-icon.png', SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={metaImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@azusachino" />
    <meta name="twitter:creator" content="@azusachino" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={metaImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="theme-color" content="#39c5bb" />
    <script is:inline define:vars={{ palettes: PALETTES.map((p) => p.id) }}>
      (() => {
        // Apply theme and palette before first paint.
        const root = document.documentElement;
        let mode = 'auto';
        try {
          const saved = localStorage.getItem('theme');
          if (['auto', 'light', 'dark'].includes(saved)) mode = saved;
        } catch {}

        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        const effectiveTheme = mode === 'auto' ? (systemDark.matches ? 'dark' : 'light') : mode;
        root.dataset.themeMode = mode;
        root.dataset.theme = effectiveTheme;

        const palette = localStorage.getItem('palette');
        if (palette && palette !== 'teal' && palettes.includes(palette)) root.dataset.palette = palette;

        if (!window.__harusThemeListener) {
          window.__harusThemeListener = true;
          systemDark.addEventListener('change', (e) => {
            let currentMode = 'auto';
            try {
              const saved = localStorage.getItem('theme');
              if (['auto', 'light', 'dark'].includes(saved)) currentMode = saved;
            } catch {}
            if (currentMode === 'auto') {
              root.dataset.theme = e.matches ? 'dark' : 'light';
              window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: root.dataset.theme, mode: 'auto' } }));
            }
          });
        }
      })();
    </script>
  </head>
  <body>
    {progress && <div class="piano-progress" aria-hidden="true"></div>}
    <Header />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <Call />
      <p class="sign mono">♪ {SITE.title} · {SITE.author}</p>
      <nav class="links mono" aria-label="Elsewhere">
        <a href="/travel/">Travel</a>
        <a href="/tags/">Tags</a>
        <a href="/cv/">CV</a>
        <a href="https://github.com/azusachino">GitHub</a>
        <a href="https://twitter.com/azusachino">X</a>
        <a href="https://iroha.azusachino.com">iroha</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <p class="credit">
        Miku illustrations are AI-generated (ChatGPT) fan art of Hatsune Miku, a character by Crypton Future Media, Inc.,
        made under the <a href="https://piapro.jp/license/pcl">Piapro Character License</a>. Not an official work.
      </p>
    </footer>
    <BackToTop />
    <Search />
    <script is:inline data-astro-rerun>
      // Favicon and browser theme color follow the palette and mode: the same
      // "ID" mark as public/favicon.svg, repainted with the current --glow.
      (() => {
        const root = document.documentElement;
        const icon = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        const meta = document.querySelector('meta[name="theme-color"]');
        const paint = () => {
          const css = getComputedStyle(root);
          const glow = css.getPropertyValue('--glow').trim() || '#39c5bb';
          const ink = css.getPropertyValue('--on-glow').trim() || '#2b2f32';
          const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="${glow}"/><path d="M17 15v34M30 15h6a17 17 0 0 1 0 34h-6Z" fill="none" stroke="${ink}" stroke-width="6.5" stroke-linejoin="round" stroke-linecap="round"/></svg>`;
          icon.href = `data:image/svg+xml,${encodeURIComponent(svg)}`;
          meta.content = glow;
        };
        paint();
        new MutationObserver(paint).observe(root, { attributes: true, attributeFilter: ['data-palette', 'data-theme'] });
      })();
    </script>
    <script is:inline data-astro-rerun>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;

        const updateButton = () => {
          const root = document.documentElement;
          const mode = root.dataset.themeMode || 'auto';
          const theme = root.dataset.theme || 'light';
          const title = mode === 'auto'
            ? `Theme: System (${theme}) · Click to switch`
            : `Theme: ${mode === 'dark' ? 'Dark' : 'Light'} · Click to switch`;
          btn.setAttribute('title', title);
          btn.setAttribute('aria-label', title);
        };

        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const currentMode = root.dataset.themeMode || 'auto';
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

          let nextMode;
          if (currentMode === 'auto') {
            nextMode = root.dataset.theme === 'dark' ? 'light' : 'dark';
          } else {
            const oppositeOfSystem = systemDark ? 'light' : 'dark';
            nextMode = currentMode === oppositeOfSystem ? (systemDark ? 'dark' : 'light') : 'auto';
          }

          const effectiveTheme = nextMode === 'auto' ? (systemDark ? 'dark' : 'light') : nextMode;
          root.dataset.themeMode = nextMode;
          root.dataset.theme = effectiveTheme;

          try {
            localStorage.setItem('theme', nextMode);
          } catch {}

          updateButton();
          window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: effectiveTheme, mode: nextMode } }));
        });

        window.addEventListener('theme-change', updateButton);
        updateButton();
      })();
    </script>
  </body>
</html>

<style>
  /* A quiet band: a light wash of the palette (18% --glow in the page
     background) with a --glow edge in light mode, charcoal with the same edge
     in dark. A full --glow fill made the penlights vibrate. The mix is plain
     sRGB so contrast.ts can compute the same color. */
  .site-footer {
    text-align: center;
    padding: 1.6rem 1rem 2rem;
    font-size: 0.8rem;
    background: color-mix(in srgb, var(--glow) 18%, var(--bg));
    color: var(--ink);
    border-top: 2px solid var(--glow);
  }

  :global(:root[data-theme='dark']) .site-footer {
    background: var(--surface);
  }

  .site-footer a {
    color: inherit;
  }

  .site-footer :focus-visible {
    outline-color: var(--primary);
  }

  .sign {
    margin: 0.2rem 0 0.6rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin: 0 0 0.8rem;
  }

  .links a {
    white-space: nowrap;
  }

  .credit {
    max-width: 44rem;
    margin: 0 auto;
    font-size: 0.72rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
